+"""Record the checksum of the pinned local Q8_0 GGUF without starting a model."""
+import hashlib
+
+from assistant import qwen27_engine as qwen
+from assistant.learning_batches import save
+
+
+def verify():
+    model = qwen.ASSETS / 'chat-q8' / qwen.Q8_NAME
+    before = qwen.identity(model)
+    if before[0] != qwen.Q8_SIZE:
+        raise ValueError('Q8_0 權重大小不符，請確認下載完成。')
+    with model.open('rb') as stream:
+        checksum = hashlib.file_digest(stream, 'sha256').hexdigest()
+    if checksum != qwen.Q8_SHA256 or qwen.identity(model) != before:
+        raise ValueError('Q8_0 權重的 SHA-256 不符或檔案在核對期間變更。')
+    save(qwen.ASSETS / 'chat-q8-verified.json', {
+        'file': qwen.Q8_NAME, 'size': before[0], 'sha256': checksum, 'mtime_ns': before[1],
+    })
+    return model
+
+
+if __name__ == '__main__':
+    print(verify())
