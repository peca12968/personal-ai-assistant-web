diff --git a/scripts/learning/qwen27_worker.py b/scripts/learning/qwen27_worker.py
new file mode 100644
index 0000000000000000000000000000000000000000..708b4fc31bc3749e36fd5fbae10da8d70c52bac7
--- /dev/null
+++ b/scripts/learning/qwen27_worker.py
@@ -0,0 +1,146 @@
+"""Offline BF16 training for the last four Qwen3.8-27B text layers."""
+import argparse
+import hashlib
+import os
+from pathlib import Path
+import sys
+
+if __package__ in (None, ''):
+    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from assistant.learning_batches import save
+from assistant.local_models import read_json
+from assistant.local_worker import SYSTEM_GUIDANCE
+from assistant.qwen27_engine import ASSETS
+from scripts.learning.runtime import consume_fit_ticket, ModelPowerRequired, require_web_model, web_model_task
+
+
+TAIL_LAYERS = 4
+SEED = 20261126
+MAX_SEQUENCE = 384
+
+
+def parameters_digest(parameters):
+    import torch
+
+    digest = hashlib.sha256()
+    for name, param in sorted(parameters):
+        data = param.detach().cpu().contiguous()
+        digest.update(str((name, data.dtype, data.shape)).encode())
+        digest.update(data.view(torch.uint8).numpy().tobytes())
+    return digest.hexdigest()
+
+
+def example_tokens(tokenizer, row):
+    reserved = set(tokenizer.all_special_ids)
+    prompt = tokenizer.encode(row['prompt'], add_special_tokens=False)
+    answer = tokenizer.encode(row['answer'], add_special_tokens=False)
+    if not answer or not reserved.isdisjoint(prompt + answer):
+        raise ValueError('訓練內容含保留的角色標記或沒有有效答案。')
+    prefix = tokenizer.apply_chat_template([{'role': 'system', 'content': SYSTEM_GUIDANCE},
+        {'role': 'user', 'content': row['prompt']}], tokenize=True, return_dict=False,
+        add_generation_prompt=True, enable_thinking=False)
+    target = answer + [tokenizer.convert_tokens_to_ids('<|im_end|>')]
+    if len(prefix) + len(target) > MAX_SEQUENCE:
+        raise ValueError(f'單個確認問答連同角色格式最多 {MAX_SEQUENCE} token。')
+    return prefix + target, target
+
+
+def fit(folder):
+    require_web_model('training')
+    os.environ.update(HF_HUB_OFFLINE='1', TRANSFORMERS_OFFLINE='1', TOKENIZERS_PARALLELISM='false',
+                      CUDA_CACHE_PATH=str(ASSETS / 'cuda-cache'), HF_HOME=str(ASSETS / 'cache'),
+                      TORCH_HOME=str(ASSETS / 'cache'), TORCHINDUCTOR_CACHE_DIR=str(ASSETS / 'torch-cache'))
+    import torch
+    from peft import LoraConfig, TaskType, get_peft_model
+    from torch import nn
+    from torch.func import functional_call
+    from transformers import AutoTokenizer
+    from transformers.models.qwen3_5.modeling_qwen3_5 import Qwen3_5ForConditionalGeneration
+
+    class FrozenCPUBlock(nn.Module):
+        def __init__(self, block, device):
+            super().__init__()
+            self.block, self.device = block, device
+            if any(p.requires_grad or p.device.type != 'cpu' for p in block.parameters()):
+                raise ValueError('offload prefix must be frozen on the CPU')
+
+        def forward(self, *args, **kwargs):
+            with torch.no_grad():
+                state = {name: p.to(self.device) for name, p in self.block.named_parameters()}
+                state.update({name: p.to(self.device) for name, p in self.block.named_buffers()})
+                return functional_call(self.block, state, args, kwargs, strict=True)
+
+    manifest = read_json(folder / 'manifest.json', 1024 * 1024)
+    torch.set_num_threads(6)
+    torch.manual_seed(SEED)
+    if not torch.cuda.is_available() or not torch.cuda.is_bf16_supported(including_emulation=False):
+        raise RuntimeError('CUDA 裝置不支援原生 BF16。')
+    device = torch.device('cuda:0')
+    torch.cuda.set_per_process_memory_fraction(0.88, device)
+    source = ASSETS / 'train'
+    tokenizer = AutoTokenizer.from_pretrained(source, local_files_only=True, trust_remote_code=False)
+    examples = [example_tokens(tokenizer, row) for row in manifest['items']]
+    save(folder / 'progress.json', {'phase': 'loading', 'step': 0})
+    base = Qwen3_5ForConditionalGeneration.from_pretrained(source, dtype='auto', device_map={'': 'cpu'},
+             local_files_only=True, trust_remote_code=False, use_safetensors=True, attn_implementation='sdpa')
+    base.requires_grad_(False)
+    language = base.model.language_model
+    count = len(language.layers)
+    split = count - TAIL_LAYERS
+    if count != 64 or language.embed_tokens.weight.dtype != torch.bfloat16:
+        raise ValueError('底座不是預期的 64 層 BF16 Qwen3.8-27B。')
+    model = get_peft_model(base, LoraConfig(task_type=TaskType.CAUSAL_LM, r=8, lora_alpha=16, lora_dropout=0,
+        layers_to_transform=list(range(split, count)), layers_pattern='layers',
+        target_modules=['q_proj', 'v_proj', 'gate_proj', 'up_proj', 'down_proj']))
+    for module in (language.embed_tokens, language.rotary_emb, language.norm, base.lm_head):
+        module.to(device)
+    for pos in range(count):
+        if pos < split:
+            language.layers[pos] = FrozenCPUBlock(language.layers[pos], device)
+        else:
+            language.layers[pos].to(device)
+    parameters = [(name, p) for name, p in model.named_parameters() if p.requires_grad]
+    if not parameters or any('lora_' not in name or p.device.type != 'cuda' for name, p in parameters):
+        raise ValueError('適配器的可訓練參數無法核對。')
+    initial = parameters_digest(parameters)
+    trainable = [p for _, p in parameters]
+    optimizer = torch.optim.AdamW(trainable, lr=2e-4, weight_decay=0)
+    model.train()
+    steps = []
+    epochs = max(2, (8 + len(examples) - 1) // len(examples))
+    for step, (ids, target) in enumerate(examples * epochs, 1):
+        inputs = torch.tensor([ids], device=device)
+        labels = torch.tensor(target, device=device)
+        optimizer.zero_grad(set_to_none=True)
+        with torch.autocast('cuda', dtype=torch.bfloat16, cache_enabled=False):
+            output = model(input_ids=inputs, attention_mask=torch.ones_like(inputs), use_cache=False,
+                           logits_to_keep=len(target) + 1).logits[0, :-1]
+            loss = nn.functional.cross_entropy(output.float(), labels)
+        if not torch.isfinite(loss):
+            raise ValueError('訓練損失不為有限值。')
+        loss.backward()
+        gradient = nn.utils.clip_grad_norm_(trainable, 1, error_if_nonfinite=True)
+        if float(gradient) <= 0:
+            raise ValueError('適配器沒有有效梯度。')
+        optimizer.step()
+        steps.append({'loss': float(loss.detach()), 'gradient': float(gradient)})
+        save(folder / 'progress.json', {'phase': 'training', 'step': step, 'total': len(examples) * epochs})
+    final = parameters_digest(parameters)
+    if initial == final:
+        raise ValueError('適配器參數未更新。')
+    model.save_pretrained(folder / 'adapter', safe_serialization=True, save_embedding_layers=False)
+    save(folder / 'fit.json', {'initial': initial, 'weights': final, 'steps': steps,
+                                'cuda_peak_reserved_mib': torch.cuda.max_memory_reserved() / 1024 ** 2})
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    parser.add_argument('folder', type=Path)
+    folder = parser.parse_args().folder
+    try:
+        consume_fit_ticket(folder, sys.stdin.readline(66).strip())
+    except ModelPowerRequired as exc:
+        parser.exit(2, str(exc) + '\n')
+    with web_model_task('training'):
+        fit(folder)
diff --git a/scripts/learning/runtime.py b/scripts/learning/runtime.py
index 7b43f429b175b8c9e62936b7121a9327e18f4acf..c65f42afff30fcb3fd68724a6cf05f43cdd4b10c 100644
--- a/scripts/learning/runtime.py
+++ b/scripts/learning/runtime.py
@@ -1,14 +1,201 @@
-"""Process-held advisory GPU lease; a leftover file never proves a live owner."""
+"""Web-authorized model tasks and process-held advisory GPU leases."""
+from contextvars import ContextVar
+import hashlib
+import json
 import os
 from contextlib import contextmanager
 from pathlib import Path
+import secrets
+from threading import Event, RLock
+import time
 
 ROOT = Path(__file__).resolve().parents[2]
+GPU_LOCK = ROOT / 'data/learning/gpu.lock'
+_WEB_TASK = ContextVar('web_model_task', default=None)
+CHAT_STAGES = {
+    'chat_context', 'chat_checking', 'chat_launch', 'chat_runtime', 'chat_assets',
+    'chat_tokenizing', 'chat_loading', 'chat_prefill', 'chat_generating',
+    'chat_completing', 'chat_finalizing',
+}
+
+
+class ModelPowerRequired(PermissionError):
+    pass
+
+
+def require_web_model(*modes):
+    task = _WEB_TASK.get()
+    if task is None or task.mode not in modes or task.cancel.is_set():
+        raise ModelPowerRequired('請由你在 IIS 網頁打開對應開關，再從該頁面送出工作。')
+
+
+class WebModelTask:
+    def __init__(self, mode, cancel=None, *, on_progress=None):
+        if mode not in ('chat', 'training'):
+            raise ValueError('無效的網頁模型授權。')
+        self.mode = mode
+        self.cancel = cancel if cancel is not None else Event()
+        self.on_progress = on_progress
+        self.token_usage = {'input_tokens': 0, 'output_tokens': 0, 'model_calls': 0}
+        self.lock = RLock()
+        self.terminators = set()
+        self.phase_starts = [('queued', time.monotonic())]
+        self.stop_requested = None
+        self.load_percent = None
+
+    @contextmanager
+    def activate(self):
+        context = _WEB_TASK.set(self)
+        try:
+            yield
+        finally:
+            _WEB_TASK.reset(context)
+
+    def force_stop(self):
+        self.cancel.set()
+        failure = None
+        with self.lock:
+            if self.stop_requested is None:
+                self.stop_requested = time.monotonic()
+            for terminate in self.terminators:
+                try:
+                    terminate()
+                except OSError as exc:
+                    failure = exc
+        if failure is not None:
+            raise failure
+
+
+def web_model_task(mode, cancel=None, *, on_progress=None):
+    return WebModelTask(mode, cancel, on_progress=on_progress).activate()
+
+
+def report_chat_stage(stage):
+    task = _WEB_TASK.get()
+    if task is None or task.mode != 'chat' or stage not in CHAT_STAGES:
+        return
+    with task.lock:
+        if task.cancel.is_set() or task.phase_starts[-1][0] == stage:
+            return
+        task.phase_starts.append((stage, time.monotonic()))
+        task.load_percent = None
+    if task.on_progress is not None:
+        task.on_progress(stage)
+    return True
+
+
+def report_chat_load(fraction):
+    task = _WEB_TASK.get()
+    if task is None or task.mode != 'chat' or type(fraction) not in (int, float) or not 0 <= fraction <= 1:
+        return
+    percent = int(fraction * 100)
+    with task.lock:
+        if not task.cancel.is_set() and task.phase_starts[-1][0] == 'chat_loading':
+            if task.load_percent is None or percent > task.load_percent:
+                task.load_percent = percent
+
+
+def chat_timing():
+    task = _WEB_TASK.get()
+    if task is None or task.mode != 'chat':
+        return None
+    with task.lock:
+        points = list(task.phase_starts)
+        if len(points) < 2:
+            return None
+        ended = task.stop_requested if task.stop_requested is not None else time.monotonic()
+    origin = points[0][1]
+    offsets = [round((stamp - origin) * 1000) for _, stamp in points]
+    total = round((ended - origin) * 1000)
+    durations = [finish - start for start, finish in zip(offsets, offsets[1:] + [total], strict=True)]
+    return {'total_ms': total, 'stages': [{'stage': name, 'elapsed_ms': duration}
+                                        for (name, _), duration in zip(points, durations, strict=True)]}
+
+
+def report_chat_usage(input_tokens, output_tokens):
+    task = _WEB_TASK.get()
+    if task is None or task.mode != 'chat' or task.cancel.is_set() or task.token_usage is None:
+        return
+    if type(input_tokens) is not int or type(output_tokens) is not int or min(input_tokens, output_tokens) <= 0:
+        task.token_usage = None
+        return
+    task.token_usage['input_tokens'] += input_tokens
+    task.token_usage['output_tokens'] += output_tokens
+    task.token_usage['model_calls'] += 1
+
+
+def chat_token_usage():
+    task = _WEB_TASK.get()
+    if (task is not None and task.mode == 'chat' and not task.cancel.is_set()
+            and task.token_usage is not None and task.token_usage['model_calls']):
+        return dict(task.token_usage)
+    return None
+
+
+@contextmanager
+def owned_web_process(terminate, start):
+    task = _WEB_TASK.get()
+    if task is None:
+        start()
+        yield
+        return
+    with task.lock:
+        require_web_model(task.mode)
+        task.terminators.add(terminate)
+        try:
+            start()
+        except BaseException:
+            task.terminators.discard(terminate)
