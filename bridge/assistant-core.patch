index 0000000000000000000000000000000000000000..db2b786e52eb43790257332b13475e81cd4b0401
--- /dev/null
+++ b/assistant/chat_history.py
@@ -0,0 +1,70 @@
+"""SQL history retention for a user-selected conversation."""
+import re
+
+
+def session_id(value):
+    if not isinstance(value, str) or not re.fullmatch('[0-9a-f]{32}', value):
+        raise ValueError('對話編號無效。')
+    return value
+
+
+def assert_active(db, sid):
+    if db.execute('SELECT 1 FROM chat_history_state WHERE session_id=?', (sid,)).fetchone():
+        raise ValueError('此對話已移到回收筒或已永久刪除。')
+
+
+def validate_saved(db):
+    for sid, state, changed_at in db.execute('SELECT session_id,state,changed_at FROM chat_history_state'):
+        session_id(sid)
+        if (state not in ('trash', 'purged') or not isinstance(changed_at, str) or not changed_at
+                or not db.execute('SELECT 1 FROM sessions WHERE id=?', (sid,)).fetchone()
+                or (state == 'purged' and db.execute('SELECT 1 FROM messages WHERE session_id=?', (sid,)).fetchone())):
+            raise ValueError('聊天歷史保存狀態不符。')
+
+
+def trash(store):
+    with store.connect() as db:
+        return [dict(row) for row in db.execute("""SELECT s.id, s.title, h.changed_at
+            FROM chat_history_state h JOIN sessions s ON s.id=h.session_id
+            WHERE h.state='trash' ORDER BY h.changed_at DESC, s.id""")]
+
+
+def change(store, sid, operation):
+    sid = session_id(sid)
+    with store.connect() as db:
+        if operation == 'purge':
+            db.execute('PRAGMA secure_delete = ON')
+        db.execute('BEGIN IMMEDIATE')
+        row = db.execute("""SELECT h.state FROM sessions s
+            LEFT JOIN chat_history_state h ON h.session_id=s.id WHERE s.id=?""", (sid,)).fetchone()
+        if row is None or row['state'] == 'purged':
+            raise ValueError('找不到這段對話。')
+        if db.execute("SELECT 1 FROM answer_runs WHERE session_id=? AND status='running'", (sid,)).fetchone():
+            raise ValueError('這段對話還有回答在進行，請先停止。')
+        if operation == 'trash' and row['state'] is None:
+            db.execute("INSERT INTO chat_history_state(session_id,state) VALUES(?,'trash')", (sid,))
+        elif operation == 'restore' and row['state'] == 'trash':
+            db.execute('DELETE FROM chat_history_state WHERE session_id=?', (sid,))
+        elif operation == 'purge' and row['state'] == 'trash':
+            purge(db, sid)
+        else:
+            raise ValueError('對話狀態已變更，請重新整理。')
+    return {'id': sid, 'operation': operation}
+
+
+def purge(db, sid):
+    # Remove the SQL chat and its owned reply records. Keep the session id for
+    # separately retained workflow, document, memory and learning references.
+    if db.execute('''SELECT 1 FROM autonomous_conversations c JOIN autonomous_goals g ON c.goal_id=g.id
+                     WHERE g.session_id=? LIMIT 1''', (sid,)).fetchone():
+        raise ValueError('有自主工作依賴這段聊天的來源快照，可先保留在回收筒。')
+    matching = 'SELECT id FROM messages WHERE session_id=?'
+    db.execute('DELETE FROM answer_runs WHERE session_id=?', (sid,))
+    db.execute('DELETE FROM chat_draft_submissions WHERE session_id=?', (sid,))
+    db.execute('DELETE FROM chat_drafts WHERE session_id=?', (sid,))
+    for table in ('feedback_versions', 'feedback', 'answer_checks', 'answer_contexts',
+                  'answer_deliveries', 'local_memory_messages'):
+        db.execute(f'DELETE FROM {table} WHERE message_id IN ({matching})', (sid,))
+    db.execute('DELETE FROM messages WHERE session_id=?', (sid,))
+    db.execute("UPDATE sessions SET title='已永久刪除的對話' WHERE id=?", (sid,))
+    db.execute("UPDATE chat_history_state SET state='purged',changed_at=CURRENT_TIMESTAMP WHERE session_id=?", (sid,))
