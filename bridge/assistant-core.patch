+class Handler(BaseHTTPRequestHandler):
+    def log_message(self, *args):
+        pass
+
+    def send(self, status, body, kind):
+        self.send_response(status)
+        self.send_header('Content-Type', kind + '; charset=utf-8')
+        self.send_header('Content-Length', str(len(body)))
+        self.send_header('Cache-Control', 'no-store')
+        self.send_header('Referrer-Policy', 'no-referrer')
+        self.send_header('X-Content-Type-Options', 'nosniff')
+        self.send_header('Content-Security-Policy',
+                         "default-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'")
+        self.end_headers()
+        self.wfile.write(body)
+
+    def json(self, value, status=HTTPStatus.OK):
+        self.send(status, json.dumps(value, ensure_ascii=False).encode('utf-8'), 'application/json')
+
+    def authorized(self):
+        return secrets.compare_digest(self.headers.get('Authorization', ''), 'Bearer ' + self.server.key)
+
+    def do_GET(self):
+        self.handle_route(post=False)
+
+    def do_POST(self):
+        self.handle_route(post=True)
+
+    def handle_route(self, *, post):
+        if self.headers.get('Host') != self.server.authority:
+            return self.json({'error': '此服務只接受桌面視窗的本機位址。'}, HTTPStatus.FORBIDDEN)
+        url = urlsplit(self.path)
+        if not post and url.path in FILES and not url.query:
+            filename, kind = FILES[url.path]
+            return self.send(HTTPStatus.OK, (STATIC / filename).read_bytes(), kind)
+        if not url.path.startswith('/api/') or not self.authorized():
+            return self.json({'error': '請從個人助理的啟動程式開啟視窗。'}, HTTPStatus.UNAUTHORIZED)
+        route = url.path[5:]
+        state = self.server.app
+        try:
+            if post:
+                if self.headers.get('Origin') != self.server.address:
+                    return self.json({'error': '無法核對本機視窗來源。'}, HTTPStatus.FORBIDDEN)
+                if self.headers.get_content_type() != 'application/json':
+                    raise ValueError('操作只接受 JSON。')
+                size = int(self.headers.get('Content-Length', 0))
+                limit = MAX_DRAFT_BODY if route == 'draft' else MAX_BODY
+                if not 1 <= size <= limit:
+                    raise ValueError('本機請求大小不符。')
+                self.connection.settimeout(5)
+                body = json.loads(self.rfile.read(size))
+                if not isinstance(body, dict):
+                    raise ValueError('本機請求必須是 JSON 物件。')
+                return self.json(state.dispatch(route, body))
+            if route == 'view':
+                arguments = parse_qs(url.query, keep_blank_values=True)
+                return self.json(state.view(arguments.get('sid', [None])[0], before=arguments.get('before', [None])[0]))
+            if route == 'draft':
+                return self.json(state.draft(parse_qs(url.query).get('sid', [None])[0]))
+            if route == 'correction':
+                args = parse_qs(url.query)
+                message_id = args.get('message_id', [''])[0]
+                if len(message_id) > 19 or not message_id.isascii() or not message_id.isdecimal():
+                    raise ValueError('回答編號無效。')
+                return self.json(state.correction(args.get('sid', [None])[0], int(message_id)))
+            if route == 'status':
+                return self.json(state.status())
+            if route == 'trash':
+                return self.json({'sessions': chat_history.trash(state.store)})
+            if route == 'learning':
+                return self.json(state.learning())
+            return self.json({'error': '找不到本機頁面。'}, HTTPStatus.NOT_FOUND)
+        except (chat_drafts.DraftConflict, CorrectionConflict, answer_runs.RetryConflict) as exc:
+            return self.json({'error': str(exc)}, HTTPStatus.CONFLICT)
+        except (ValueError, OSError, RuntimeError, KeyError, TypeError, sqlite3.Error) as exc:
+            return self.json({'error': str(exc)[:4000]}, HTTPStatus.BAD_REQUEST)
+
+
+@contextmanager
+def server_for(app):
+    with ThreadingHTTPServer(('127.0.0.1', 0), Handler) as server:
+        server.app = app
+        server.key = secrets.token_urlsafe(24)
+        server.authority = '127.0.0.1:' + str(server.server_port)
+        server.address = 'http://' + server.authority
+        thread = Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        try:
+            yield server.address, server.key
+        finally:
+            server.shutdown()
+            thread.join()
+            app.close()
+
+
+def edge_executable():
+    if os.name == 'nt':
+        import winreg
+        key = r'Software\Microsoft\Windows\CurrentVersion\App Paths\msedge.exe'
+        for hive in (winreg.HKEY_CURRENT_USER, winreg.HKEY_LOCAL_MACHINE):
+            for bits in (winreg.KEY_WOW64_32KEY, winreg.KEY_WOW64_64KEY):
+                try:
+                    with winreg.OpenKey(hive, key, access=winreg.KEY_READ | bits) as handle:
+                        path = Path(winreg.QueryValueEx(handle, '')[0].strip('"'))
+                    if path.is_file():
+                        return path
+                except OSError:
+                    continue
+    system = os.environ.get('SystemDrive', 'C:') + '/'
+    homes = (os.environ.get('ProgramFiles(x86)', system + 'Program Files (x86)'),
+             os.environ.get('ProgramFiles', system + 'Program Files'), os.environ.get('LOCALAPPDATA'))
+    for directory in homes:
+        path = Path(directory or '.') / 'Microsoft/Edge/Application/msedge.exe'
+        if directory and path.is_file():
+            return path
+    raise OSError('找不到 Microsoft Edge，本機 HTML 視窗無法開啟。')
+
+
+def run_window(store):
+    app = ChatApp(store)
+    workspace = store.path.parent / 'local-engine-workspace'
+    workspace.mkdir(parents=True, exist_ok=True)
+    edge = edge_executable()
+    with server_for(app) as (address, key):
+        # The Edge profile is unique to this session. Its job owns browser children.
+        with TemporaryDirectory(prefix='html-profile-', dir=workspace, ignore_cleanup_errors=True) as profile:
+            command = [str(edge), '--app=' + address + '/#key=' + key, '--user-data-dir=' + profile,
+                       '--no-first-run', '--no-default-browser-check', '--disable-background-mode',
+                       '--disable-extensions']
+            with windows_process(command, hidden=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) as process:
+                while process.poll() is None:
+                    time.sleep(0.2)
+
+
+def main():
+    parser = argparse.ArgumentParser(description='啟動本機 HTML 聊天視窗')
+    parser.add_argument('--data-dir', type=Path, default=ROOT / 'data')
+    args = parser.parse_args()
+    try:
+        run_window(Store(args.data_dir / 'assistant.sqlite3'))
+    except (ValueError, OSError, RuntimeError, sqlite3.Error) as exc:
+        parser.exit(1, '本機助理無法開啟視窗。' + str(exc) + '\n')
+
+
+if __name__ == '__main__':
+    main()
