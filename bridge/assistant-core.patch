new file mode 100644
index 0000000000000000000000000000000000000000..e4eb5a10dc46324b1b090f690f31e8a78de363f8
--- /dev/null
+++ b/assistant/owned_process.py
@@ -0,0 +1,90 @@
+"""Run a Windows subprocess in a job that closes the complete process tree."""
+from contextlib import contextmanager
+import ctypes as c
+from ctypes import wintypes as w
+import os
+import subprocess
+import time
+from scripts.learning.runtime import owned_web_process
+
+
+class BasicLimits(c.Structure):
+    _fields_ = [('process_time', c.c_longlong), ('job_time', c.c_longlong), ('flags', w.DWORD),
+                ('min_working', c.c_size_t), ('max_working', c.c_size_t), ('active', w.DWORD),
+                ('affinity', c.c_size_t), ('priority', w.DWORD), ('scheduling', w.DWORD)]
+
+
+class ExtendedLimits(c.Structure):
+    _fields_ = [('basic', BasicLimits), ('io', c.c_ulonglong * 6),
+                ('memory', c.c_size_t * 4)]
+
+
+class Accounting(c.Structure):
+    _fields_ = [('times', c.c_longlong * 4), ('faults', w.DWORD), ('total', w.DWORD),
+                ('active', w.DWORD), ('terminated', w.DWORD)]
+
+
+@contextmanager
+def windows_process(command, *, hidden=True, **options):
+    if os.name != 'nt':
+        raise OSError('此本機程序需要 Windows。')
+    api = c.WinDLL('kernel32', use_last_error=True)
+    signatures = {
+        'CreateJobObjectW': ([c.c_void_p, w.LPCWSTR], w.HANDLE),
+        'SetInformationJobObject': ([w.HANDLE, c.c_int, c.c_void_p, w.DWORD], w.BOOL),
+        'AssignProcessToJobObject': ([w.HANDLE, w.HANDLE], w.BOOL),
+        'QueryInformationJobObject': ([w.HANDLE, c.c_int, c.c_void_p, w.DWORD, c.c_void_p], w.BOOL),
+        'TerminateJobObject': ([w.HANDLE, w.UINT], w.BOOL),
+        'CloseHandle': ([w.HANDLE], w.BOOL),
+    }
+    for name, (args, result) in signatures.items():
+        function = getattr(api, name)
+        function.argtypes, function.restype = args, result
+    resume = c.WinDLL('ntdll').NtResumeProcess
+    resume.argtypes, resume.restype = [w.HANDLE], w.LONG
+    job = api.CreateJobObjectW(None, None)
+    if not job:
+        raise c.WinError(c.get_last_error())
+    try:
+        limits = ExtendedLimits()
+        limits.basic.flags = 0x2000  # JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
+        if not api.SetInformationJobObject(job, 9, c.byref(limits), c.sizeof(limits)):
+            raise c.WinError(c.get_last_error())
+        # Suspend until the job owns even children spawned by a venv redirector.
+        flags = 0x4 | (subprocess.CREATE_NO_WINDOW if hidden else 0)
+        process = subprocess.Popen(command, creationflags=flags, **options)
+
+        def terminate():
+            if not api.TerminateJobObject(job, 1):
+                raise c.WinError(c.get_last_error())
+
+        try:
+            handle = int(process._handle)
+            if not api.AssignProcessToJobObject(job, handle):
+                raise c.WinError(c.get_last_error())
+            def start():
+                if resume(handle) != 0:
+                    raise OSError('Windows 無法啟動已受控的本機程序。')
+
+            with owned_web_process(terminate, start):
+                yield process
+        finally:
+            try:
+                terminate()
+                if process.poll() is None:
+                    process.kill()  # Also handles an unassigned, suspended process.
+                process.wait(timeout=10)
+                status = Accounting()
+                deadline = time.monotonic() + 10
+                while True:
+                    if not api.QueryInformationJobObject(job, 1, c.byref(status), c.sizeof(status), None):
+                        raise c.WinError(c.get_last_error())
+                    if status.active == 0:
+                        break
+                    if time.monotonic() >= deadline:
+                        raise TimeoutError('無法確認本機程序樹已結束。')
+                    time.sleep(0.03)
+            except ProcessLookupError:
+                process.wait(timeout=10)
+    finally:
+        api.CloseHandle(job)
