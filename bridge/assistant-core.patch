+                deadline = time.monotonic() + 5
+                while observer.handle is None and time.monotonic() < deadline:
+                    observer.observe()
+                    time.sleep(.05)
+                self.assertIsNotNone(observer.handle)
+                self.assertEqual(app.change_mode('off'), {'mode': 'off'})
+                self.assertEqual(observer.api.WaitForSingleObject(observer.handle, 0), 0)
