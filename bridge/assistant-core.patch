+                    view = call('view?sid=' + self.sid)
+                    seen.append(view['retry'])
+                    self.assertEqual(view['retry']['user_message_id'], view['messages'][-1]['id'])
+                    self.assertEqual(view['retry']['status'], 'cancelled')
+                for stale in ({}, {'expected_run_id': seen[0]['id']}):
+                    with self.assertRaises(HTTPError) as failure:
