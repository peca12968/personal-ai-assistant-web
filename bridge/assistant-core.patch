+    def test_web_reports_the_durable_draft_receipt_before_the_answer_finishes(self):
+        app = ChatApp(self.store, controlled=True)
+        app.change_mode('chat')
+        entered = Event()
+        finish = Event()
+        question = '請用一個字猜這張測試卡的內容。'
+        snapshot = app.draft(self.sid, {'revision': 0, 'content': question})
