+        with patch.object(app.engine, 'answer', side_effect=answer), server_for(app) as (address, token):
+            admitted = app.dispatch('ask', {'sid': self.sid, 'question': question, 'draft_revision': snapshot['revision']})
+            try:
+                self.assertTrue(entered.wait(5))
+                request = Request(address + '/api/status', headers={'Authorization': 'Bearer ' + token})
+                with urlopen(request, timeout=4) as response:
+                    state = json.load(response)
+                self.assertEqual(state['id'], admitted['id'])
+                self.assertTrue(state['running'])
+                self.assertTrue(state['draft_submitted'])
+                self.assertEqual([item['content'] for item in app.view(self.sid)['messages']], [question])
+                saved_next = app.draft(self.sid, {'revision': snapshot['revision'] + 1, 'content': '先輸入下一題'})
+            finally:
+                finish.set()
+                app.worker.join(6)
+            self.assertFalse(app.status()['running'])
+            self.assertEqual(app.draft(self.sid), saved_next)
