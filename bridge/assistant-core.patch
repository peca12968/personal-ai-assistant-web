+"""Web-authorized model tasks and process-held advisory GPU leases."""
+from contextvars import ContextVar
+import hashlib
+import json
 import os
 from contextlib import contextmanager
 from pathlib import Path
+import secrets
+from threading import Event, RLock
+import time
 
 ROOT = Path(__file__).resolve().parents[2]
+GPU_LOCK = ROOT / 'data/learning/gpu.lock'
+_WEB_TASK = ContextVar('web_model_task', default=None)
+
+
+class ModelPowerRequired(PermissionError):
+    pass
+
+
+def require_web_model(*modes):
+    task = _WEB_TASK.get()
+    if task is None or task.mode not in modes or task.cancel.is_set():
+        raise ModelPowerRequired('請由你在 IIS 網頁打開對應開關，再從該頁面送出工作。')
+
+
+class WebModelTask:
+    def __init__(self, mode, cancel=None):
+        if mode not in ('chat', 'training'):
+            raise ValueError('無效的網頁模型授權。')
+        self.mode = mode
+        self.cancel = cancel if cancel is not None else Event()
+        self.lock = RLock()
+        self.terminators = set()
+
+    @contextmanager
+    def activate(self):
+        context = _WEB_TASK.set(self)
+        try:
+            yield
+        finally:
+            _WEB_TASK.reset(context)
+
+    def force_stop(self):
+        self.cancel.set()
+        failure = None
+        with self.lock:
+            for terminate in self.terminators:
+                try:
+                    terminate()
+                except OSError as exc:
+                    failure = exc
+        if failure is not None:
+            raise failure
+
+
+def web_model_task(mode, cancel=None):
+    return WebModelTask(mode, cancel).activate()
+
+
+@contextmanager
+def owned_web_process(terminate, start):
+    task = _WEB_TASK.get()
+    if task is None:
+        start()
+        yield
+        return
+    with task.lock:
+        require_web_model(task.mode)
+        task.terminators.add(terminate)
+        try:
+            start()
+        except BaseException:
+            task.terminators.discard(terminate)
+            raise
+    try:
+        yield
+    finally:
+        with task.lock:
+            task.terminators.discard(terminate)
+
+
+@contextmanager
+def model_launch_ticket(folder, mode):
+    require_web_model(mode)
+    marker = Path(folder) / {'training': 'fit-admission.json', 'chat': 'chat-admission.json'}[mode]
+    proof = secrets.token_hex(32)
+    with marker.open('x', encoding='ascii') as stream:
+        json.dump({'digest': hashlib.sha256(proof.encode('ascii')).hexdigest(),
+                   'expires': time.time() + 120}, stream)
+    try:
+        yield proof
+    finally:
+        marker.unlink(missing_ok=True)
+
+
+def consume_model_launch_ticket(folder, mode, proof):
+    marker = Path(folder) / {'training': 'fit-admission.json', 'chat': 'chat-admission.json'}[mode]
+    try:
+        if len(proof) != 64 or any(c not in '0123456789abcdef' for c in proof):
+            raise ValueError('invalid proof')
+        with marker.open(encoding='ascii') as stream:
+            record = json.loads(stream.read(512))
+        if time.time() >= record['expires'] or not secrets.compare_digest(
+                record['digest'], hashlib.sha256(proof.encode('ascii')).hexdigest()):
+            raise ValueError('invalid ticket')
+        marker.unlink()  # Atomic one-time consumption before loading weights.
+    except (KeyError, OSError, ValueError, TypeError) as exc:
+        raise ModelPowerRequired('請由網頁的對應開關啟動這個工作。') from exc
+
+
+def fit_launch_ticket(folder):
+    return model_launch_ticket(folder, 'training')
+
+
+def consume_fit_ticket(folder, proof):
+    consume_model_launch_ticket(folder, 'training', proof)
 
 
 @contextmanager
 def gpu_lease(path=None):
-    path = Path(path) if path is not None else ROOT/'data/learning/gpu.lock'
