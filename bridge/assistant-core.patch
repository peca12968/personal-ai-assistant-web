+    def test_4b_chat_reports_worker_progress_with_separate_phase_times(self):
+        root = self.store.path.parent
+        next_stage, finish = root / 'continue-probe', root / 'finish-probe'
+        engine = LocalEngine(root, web_owned=True)
+        app = ChatApp(self.store, controlled=True)
+        probe = f"""from pathlib import Path
+import time
+from assistant import local_worker
+from scripts.learning.runtime import report_chat_stage
+def wait(path):
+    until = time.monotonic() + 9
+    while not Path(path).exists():
+        if time.monotonic() >= until:
+            raise TimeoutError()
+        time.sleep(.04)
+def stub(request):
+    report_chat_stage('chat_assets')
+    wait({str(next_stage)!r})
+    report_chat_stage('chat_loading')
+    wait({str(finish)!r})
+    return {{'schema':'local_inference_result_v1','status':'succeeded','answer':'甲',
+             'selection_fingerprint':request['selection']['fingerprint'],
+             'input_tokens':2,'output_tokens':1,'peak_gpu_bytes':0}}
+local_worker.infer = stub
+raise SystemExit(local_worker.main())
+"""
+
+        def await_stage(name):
+            deadline = time.monotonic() + 7
+            while time.monotonic() < deadline:
+                state = app.status()
+                if state['stage'] == name:
+                    return state
+                time.sleep(.05)
+            self.fail('never observed ' + name + ' from the synthetic worker')
+
+        app.change_mode('chat')
+        with patch.object(engine, 'command', side_effect=lambda output: [sys.executable, '-c', probe, '--output', str(output)]):
+            measured = []
+
+            def run_answer(cancel, notice):
+                self.assertEqual(engine.answer('測試階段', cancel), '甲')
+                measured.append(chat_token_usage())
+
+            try:
+                app.start('chat', run_answer)
+                assets = await_stage('chat_assets')
+                next_stage.touch()
+                loading = await_stage('chat_loading')
+                self.assertTrue(loading['running'])
+                self.assertEqual(loading['started_at'], assets['started_at'])
+                self.assertGreater(loading['stage_started_at'], assets['stage_started_at'])
+                finish.touch()
+                app.worker.join(7)
+                self.assertEqual(app.status()['stage'], 'done')
+                self.assertEqual(app.status()['last_active_stage'], 'chat_loading')
+                self.assertEqual(measured, [{'input_tokens': 2, 'output_tokens': 1, 'model_calls': 1}])
+            finally:
+                app.change_mode('off')
