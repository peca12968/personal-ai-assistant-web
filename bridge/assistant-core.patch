+"""Interactive Windows bridge for the IIS front end, with compute off on startup."""
+import argparse
+from pathlib import Path
+import os
+import time
+
+from .engine import ROOT
+from .html_chat import ChatApp, server_for
+from .learning_batches import save
+from .local_models import read_json
+from .store import Store
+from scripts.learning.runtime import gpu_lease
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--runtime', type=Path, required=True)
+    parser.add_argument('--data-dir', type=Path, default=ROOT / 'data')
+    args = parser.parse_args()
+    runtime = args.runtime.resolve()
+    runtime.mkdir(parents=True, exist_ok=True)
+    descriptor = runtime / 'bridge.json'
+    with gpu_lease(runtime / 'bridge.lock'):
+        # Normal IIS activation runs in a service session. This bridge is started
+        # from the interactive desktop so native Windows idle and CUDA see it.
+        store = Store(args.data_dir / 'assistant.sqlite3')
+        with server_for(ChatApp(store, controlled=True)) as (address, key):
+            value = {'address': address, 'key': key, 'pid': os.getpid()}
+            save(descriptor, value)
+            try:
+                while True:
+                    time.sleep(2)
+            except KeyboardInterrupt:
+                pass
+            finally:
+                if descriptor.is_file() and read_json(descriptor) == value:
+                    descriptor.unlink()
+
+
+if __name__ == '__main__':
+    main()
