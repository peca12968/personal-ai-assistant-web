new file mode 100644
index 0000000000000000000000000000000000000000..1198a7619cf6b2d5e3f25b92b129fee70242c23f
--- /dev/null
+++ b/assistant/html_chat.py
@@ -0,0 +1,522 @@
+"""F-drive HTML desktop client for the existing local assistant and 27B runner."""
+import argparse
+from contextlib import contextmanager
+from http import HTTPStatus
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import json
+import os
+from pathlib import Path
+import secrets
+import sqlite3
+import subprocess
+from tempfile import TemporaryDirectory
+from threading import Event, RLock, Thread
+import time
+from urllib.parse import parse_qs, urlsplit
+import uuid
+
+from . import answer_runs, chat_drafts, chat_history, learning_batches, learning_queue, local_models, qwen27_learning
+from .engine import EngineError, MAX_QUESTION_CHARS, ROOT
+from .local_engine import LocalEngine
+from .local_models import read_json
+from .owned_process import windows_process
+from .qwen27_engine import CONTEXT, REPLY_TOKENS, ALIAS, Qwen27Engine
+from .store import Store
+from scripts.daily_delivery import DailyLocalEngine
+from scripts.daily_expenses import DailyAssistant
+from scripts.learning.runtime import ModelPowerRequired, WebModelTask
+
+
+STATIC = Path(__file__).parent / 'web_chat'
+FILES = {'/': ('index.html', 'text/html'), '/chat.js': ('chat.js', 'text/javascript'),
+         '/chat.css': ('chat.css', 'text/css')}
+MAX_BODY = 128 * 1024
+MAX_DRAFT_BODY = 6 * chat_drafts.MAX_CHARS + 256
+HISTORY_PAGE_SIZE = 100
+NON_MODEL_REPLIES = {'local_memory', 'local_calculation', 'local_document_calculation', 'local_transcription', 'local_evidence'}
+MODEL_4B = 'qwen3-4b-bf16'
+MODEL_OPTIONS = {
+    ALIAS: {'label': 'Qwen3.8-27B BF16', 'context_tokens': CONTEXT,
+            'input_tokens': CONTEXT - REPLY_TOKENS - 4, 'output_tokens': REPLY_TOKENS},
+    MODEL_4B: {'label': 'Qwen3-4B BF16', 'context_tokens': None,
+               'input_tokens': local_models.MAX_INPUT_TOKENS, 'output_tokens': local_models.MAX_OUTPUT_TOKENS},
+}
+
+
+class CorrectionConflict(ValueError):
+    pass
+
+
+def correction_question(payload):
+    context = json.loads(payload) if payload else {}
+    if isinstance(context, dict) and not context.get('image_inputs') and context.get('response_mode') not in NON_MODEL_REPLIES:
+        question = context.get('current_request')
+        if isinstance(question, str) and question.strip():
+            return question
+    return None
+
+
+class ChatApp:
+    def __init__(self, store, *, controlled=False):
+        self.store = store
+        self.controlled = controlled
+        self.mode = 'off'
+        self.switching = False
+        self.guard = RLock()
+        self.cancel = Event()
+        self.model_task = None
+        self.worker = None
+        self.job = {}
+        self.choice = store.path.parent / 'local-engine-workspace' / 'qwen27-choice.json'
+        self.warning = ''
+        try:
+            choice = read_json(self.choice) if self.choice.is_file() else {}
+            self.set_engine(choice.get('model', ALIAS), choice.get('batch'))
+        except (ValueError, OSError, KeyError, TypeError, AttributeError, RuntimeError, sqlite3.Error):
+            self.set_engine(ALIAS)
+            self.warning = '無法核對已保存的模型，先選用 27B BF16 底座。'
+
+    def set_engine(self, model, batch=None, *, persist=False):
+        if model == ALIAS:
+            engine = Qwen27Engine(self.store.path.parent, batch=batch)
+        elif model == MODEL_4B and batch is None:
+            engine = LocalEngine(self.store.path.parent, recover_chat_budget=True, web_owned=True)
+            if not engine.python.is_file():
+                raise EngineError('F 槽的 Qwen3-4B 執行環境尚未就緒。', 'local_environment')
+        else:
+            raise ValueError('請選擇此電腦支援的模型版本。')
+        if persist:
+            self.choice.parent.mkdir(parents=True, exist_ok=True)
+            learning_batches.save(self.choice, {'model': model, 'batch': batch})
+        self.model = model
+        self.batch = batch
+        self.engine = engine
+        self.driver = DailyAssistant(self.store, DailyLocalEngine(engine))
+
+    def model_state(self):
+        return {'id': self.model, 'batch': self.batch}
+
+    def view(self, sid, *, before=None):
+        if before is not None:
+            if (not isinstance(before, str) or len(before) > 19 or not before.isascii() or not before.isdecimal()
+                    or not 1 <= int(before) < 2**63):
+                raise ValueError('歷史分頁位置無效。')
+            return self.history_page(chat_history.session_id(sid), before=int(before))
+        rows = self.store.sessions()
+        session = next((row for row in rows if row['id'] == sid), None)
+        if session is None:
+            session = rows[0] if rows else None
+        if session is None:
+            sid = self.store.new_session()
+            rows = self.store.sessions()
+            session = rows[0]
+        sid = session['id']
+        page = self.history_page(sid)
+        try:
+            answer_runs.retry_target(self.store, sid)
+            can_retry = True
+        except ValueError:
+            can_retry = False
+        with self.guard:
+            return {**page, 'title': session['title'], 'model': self.engine.display_name,
+                    'sessions': [{key: row[key] for key in ('id', 'title')} for row in rows],
+                    'can_retry': can_retry, 'warning': self.warning, 'mode': self.mode,
+                    'models': MODEL_OPTIONS, 'selection': self.model_state()}
+
+    def history_page(self, sid, *, before=None):
+        with self.store.connect() as db:
+            db.execute('BEGIN')
+            chat_history.assert_active(db, sid)
+            if before is not None and not db.execute('SELECT 1 FROM messages WHERE session_id=? AND id=?', (sid, before)).fetchone():
+                raise ValueError('這個分頁位置已失效，請重開該對話。')
+            upper = ' AND id < ?' if before is not None else ''
+            args = (sid, before) if before is not None else (sid,)
+            recent = db.execute(f'''SELECT m.*, c.payload, f.correction FROM (
+                    SELECT id, role, content FROM messages WHERE session_id=?{upper}
+                    ORDER BY id DESC LIMIT ?
+                ) AS m LEFT JOIN answer_contexts c ON c.message_id=m.id
+                LEFT JOIN feedback f ON f.message_id=m.id AND f.rating=-1
+                ORDER BY m.id DESC''', (*args, HISTORY_PAGE_SIZE + 1)).fetchall()
+            messages = []
+            for row in reversed(recent[:HISTORY_PAGE_SIZE]):
+                message = {key: row[key] for key in ('id', 'role', 'content')}
+                question = correction_question(row['payload']) if row['role'] == 'assistant' else None
+                if question is not None:
+                    message.update(correctable=True, question=question[:2000], correction=row['correction'] or '')
+                messages.append(message)
+            draft = chat_drafts.read(db, sid) if before is None else None
+        cursor = str(messages[0]['id']) if len(recent) > HISTORY_PAGE_SIZE else None
+        page = {'sid': sid, 'messages': messages, 'before': cursor}
+        if draft is not None:
+            page['draft'] = draft
+        return page
+
+    def draft(self, sid, update=None):
+        sid = chat_history.session_id(sid)
+        with self.store.connect() as db:
+            db.execute('BEGIN' if update is None else 'BEGIN IMMEDIATE')
+            chat_history.assert_active(db, sid)
+            if update is None:
+                return chat_drafts.read(db, sid)
+            return chat_drafts.write(db, sid, update['content'], update['revision'])
+
+    def require_session(self, sid):
+        if not isinstance(sid, str) or not any(row['id'] == sid for row in self.store.sessions()):
+            raise ValueError('請選擇有效的本機對話。')
+
+    def start(self, kind, action, *, job_id=None, sid=None, draft=None):
+        with self.guard:
+            mode = 'training' if kind == 'learning' else 'chat'
+            if not self.controlled or self.mode != mode or self.switching:
+                raise ModelPowerRequired('請先在 IIS 網頁打開對應開關。')
+            if self.job.get('running'):
+                raise ValueError('目前正在處理本機工作。可先按停止，等程序退出再操作。')
+            self.cancel = Event()
+            task = self.model_task = WebModelTask(mode, self.cancel)
+            job = {'id': job_id or uuid.uuid4().hex, 'kind': kind, 'running': True, 'stage': 'queued'}
+            if sid is not None:
+                job['sid'] = sid
+            self.job = job
+
+            def progress(stage):
+                with self.guard:
+                    job['stage'] = stage
+
+            def run():
+                stage, error = 'failed', '本機背景工作中斷。'
+                try:
+                    with task.activate():
+                        result = action(task.cancel, progress)
+                    stage = result['status'] if kind == 'learning' else ('cancelled' if task.cancel.is_set() else 'done')
+                    error = result.get('error') if kind == 'learning' else None
+                except (ValueError, OSError, RuntimeError, KeyError, TypeError, sqlite3.Error) as exc:
+                    stage = 'cancelled' if task.cancel.is_set() else 'failed'
+                    error = str(exc)[:4000]
+                finally:
+                    committed = None
+                    if draft is not None:
+                        try:
+                            committed = chat_drafts.submitted(self.store, sid, draft)
+                        except (OSError, sqlite3.Error):
+                            pass  # An uncertain receipt must not clear the editor.
+                    with self.guard:
+                        if draft is not None:
+                            job['draft_submitted'] = committed
+                        job.update(stage=stage, running=False, error=error)
+
+            self.worker = Thread(target=run, daemon=True)
+            try:
+                self.worker.start()
+            except RuntimeError:
+                job.update(stage='failed', running=False, error='無法啟動本機背景工作。')
+                raise
+            return dict(job)
+
+    def correction(self, sid, message_id):
+        with self.store.connect() as db:
+            db.execute('BEGIN')
+            return self.correction_snapshot(db, sid, message_id)[0]
+
+    def correction_snapshot(self, db, sid, message_id):
+        chat_history.session_id(sid)
+        if type(message_id) is not int or not 1 <= message_id < 2**63:
+            raise ValueError('回答編號無效。')
+        chat_history.assert_active(db, sid)
+        row = db.execute('''SELECT m.content, c.payload, f.rating, f.correction, f.updated_at, v.revision
+                FROM messages m LEFT JOIN answer_contexts c ON c.message_id=m.id
+                LEFT JOIN feedback f ON f.message_id=m.id LEFT JOIN feedback_versions v ON v.message_id=m.id
+                WHERE m.id=? AND m.session_id=? AND m.role='assistant' ''', (message_id, sid)).fetchone()
+        question = correction_question(row['payload']) if row is not None else None
+        if question is None:
+            raise ValueError('請選擇有原問題快照的助理文字回答。')
+        matching = []
+        for raw in db.execute(learning_queue.LATEST + " WHERE q.source_json<>'null'"):
+            entry = learning_queue.decode(raw)
+            if entry['source']['message_id'] == message_id:
+                matching.append(entry)
+        if len(matching) > 1:
+            raise ValueError('這則回覆有多個學習例子，請先從學習佇列核對。')
+        entry = matching[0] if matching else None
+        version = learning_queue.digest({'sid': sid, 'message_id': message_id, 'reply': dict(row),
+                                         'example': entry['fingerprint'] if entry else None})
+        state = learning_queue.observed(self.store, db, entry)['readiness'] if entry else 'new'
+        saved_answer = row['correction'] if row['rating'] == -1 else ''
+        if entry and state != 'needs_review':
+            question, saved_answer = entry['prompt'], entry['answer']
+        return {'version': version, 'state': state, 'prompt': question[:2000], 'answer': saved_answer or ''}, entry
+
+    def confirm(self, body):
+        message_id, sid = body['message_id'], body['sid']
+        prompt = learning_queue.text(body['prompt'], 2000, '可獨立理解的問題')
+        answer = learning_queue.text(body['answer'], 2000, '完整正確答案')
+        with self.store.connect() as db:
+            db.execute('BEGIN IMMEDIATE')
+            snapshot, previous = self.correction_snapshot(db, sid, message_id)
+            if body.get('version') != snapshot['version']:
+                raise CorrectionConflict('更正已改版或撤回。請核對本機版本後再確認，目前輸入已保留。')
+            self.store.rate(message_id, -1, answer, db=db)
+            source = learning_queue.source_from_feedback(self.store, message_id, db=db)
+            options = {'item_id': previous['id'], 'expected_revision': previous['revision']} if previous else {}
+            entry = learning_queue.confirm(self.store, prompt, answer, source=source, db=db, **options)
+            return {'id': entry['id'], 'revision': entry['revision']}
+
+    def learning(self):
+        with self.store.connect() as db:
+            db.execute('BEGIN')
+            rows = db.execute(learning_queue.LATEST + " WHERE q.status='confirmed' ORDER BY q.rowid DESC").fetchall()
+            examples = []
+            for record in rows:
+                item = learning_queue.observed(self.store, db, learning_queue.decode(record))
+                if item['readiness'] == 'ready':
+                    examples.append({key: item[key] for key in ('id', 'prompt', 'revision', 'status')})
+        return {'examples': examples, 'jobs': qwen27_learning.recent_jobs(self.store.path.parent),
+                'active': self.batch}
+
+    def change_mode(self, requested):
+        if not self.controlled or requested not in ('off', 'chat', 'training'):
+            raise ValueError('模式請選擇關閉、使用模型或訓練。')
+        with self.guard:
+            if self.switching:
+                raise ValueError('正在等候本機程序結束。')
+            if requested == self.mode:
+                return {'mode': self.mode}
+            self.switching = True
+            self.mode = 'stopping'
+            worker, task = self.worker, self.model_task
+        try:
+            if task:
+                task.force_stop()
+            if worker:
+                worker.join(timeout=25)
+                if worker.is_alive():
+                    raise TimeoutError('尚未能確認模型程序已完全退出。')
+            with self.guard:
+                self.mode = requested
+                return {'mode': self.mode}
+        finally:
+            with self.guard:
+                self.switching = False
+
+    def dispatch(self, route, body):
+        if route == 'mode':
+            return self.change_mode(body['mode'])
+        if route == 'stop':
+            with self.guard:
+                task = self.model_task
+            if task:
+                task.force_stop()
+            return {'stopping': True}
+        if route == 'confirm':
+            return self.confirm(body)
+        if route == 'draft':
+            return self.draft(body['sid'], body)
+        if route == 'withdraw':
+            row = learning_queue.withdraw(self.store, body['id'], body['revision'])
+            return {'status': row['status']}
+        with self.guard:
+            if self.switching or self.mode == 'stopping' or self.job.get('running'):
+                raise ValueError('請等本機工作結束後再操作。')
+            if route in ('trash', 'restore', 'purge'):
+                return chat_history.change(self.store, body['sid'], route)
+            if route == 'new':
+                return {'sid': self.store.new_session()}
+            if route == 'select':
+                if 'model' not in body and 'id' not in body:
+                    raise ValueError('請選擇模型。')
+                if 'model' in body and body.get('id') is not None:
+                    raise ValueError('每次只能選擇一個模型版本。')
+                self.set_engine(body.get('model', ALIAS), body.get('id'), persist=True)
+                self.warning = ''
+                return {'model': self.engine.display_name, 'selection': self.model_state()}
+            if route == 'learn':
+                if not self.controlled or self.mode != 'training':
+                    raise ValueError('請先打開訓練開關。')
+                job_id = qwen27_learning.prepare(self.store, body['selection'], body['holdout'])
+                return self.start('learning', lambda cancel, progress: qwen27_learning.run(
+                    self.store, job_id, cancel, on_progress=progress), job_id=job_id)
+            if route in ('ask', 'retry'):
+                if not self.controlled or self.mode != 'chat':
+                    raise ValueError('請先打開使用模型開關。')
+                if 'expected_model' in body and body['expected_model'] != self.model_state():
+                    raise ValueError('其他分頁已變更模型。請核對頁首後再送出。')
+                sid = body['sid']
+                self.require_session(sid)
+                question = body.get('question')
+                submission = None
+                if route == 'ask':
+                    learning_queue.text(question, MAX_QUESTION_CHARS, '問題')
+                    if 'draft_revision' in body:
+                        snapshot = self.draft(sid)
+                        revision = body['draft_revision']
+                        if type(revision) is not int or revision < 1 or snapshot['revision'] != revision or snapshot['content'].strip() != question.strip():
+                            raise chat_drafts.DraftConflict('草稿或送出內容已變更，請先核對草稿。')
+                        submission = chat_drafts.submission(snapshot)
+                driver = self.driver
+
+                def answer(cancel, progress):
+                    progress('answering')
+                    if route == 'ask':
+                        return driver.ask(sid, question, cancel, draft=submission)
+                    return driver.retry(sid, cancel)
+
+                return self.start('chat', answer, sid=sid, draft=submission)
+        raise ValueError('找不到本機操作。')
+
+    def close(self):
+        with self.guard:
+            worker, task = self.worker, self.model_task
+        if task:
+            task.force_stop()
+        if worker:
+            worker.join(timeout=30)
+            if worker.is_alive():
+                raise TimeoutError('仍在等待本機程序退出。')
+
+
+class Handler(BaseHTTPRequestHandler):
+    def log_message(self, *args):
+        pass
+
+    def send(self, status, body, kind):
+        self.send_response(status)
+        self.send_header('Content-Type', kind + '; charset=utf-8')
+        self.send_header('Content-Length', str(len(body)))
+        self.send_header('Cache-Control', 'no-store')
+        self.send_header('Referrer-Policy', 'no-referrer')
+        self.send_header('X-Content-Type-Options', 'nosniff')
+        self.send_header('Content-Security-Policy',
+                         "default-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'")
+        self.end_headers()
+        self.wfile.write(body)
+
+    def json(self, value, status=HTTPStatus.OK):
+        self.send(status, json.dumps(value, ensure_ascii=False).encode('utf-8'), 'application/json')
+
+    def authorized(self):
+        return secrets.compare_digest(self.headers.get('Authorization', ''), 'Bearer ' + self.server.key)
+
+    def do_GET(self):
+        self.handle_route(post=False)
+
+    def do_POST(self):
+        self.handle_route(post=True)
+
+    def handle_route(self, *, post):
+        if self.headers.get('Host') != self.server.authority:
+            return self.json({'error': '此服務只接受桌面視窗的本機位址。'}, HTTPStatus.FORBIDDEN)
+        url = urlsplit(self.path)
+        if not post and url.path in FILES and not url.query:
+            filename, kind = FILES[url.path]
+            return self.send(HTTPStatus.OK, (STATIC / filename).read_bytes(), kind)
+        if not url.path.startswith('/api/') or not self.authorized():
+            return self.json({'error': '請從個人助理的啟動程式開啟視窗。'}, HTTPStatus.UNAUTHORIZED)
+        route = url.path[5:]
+        state = self.server.app
+        try:
+            if post:
+                if self.headers.get('Origin') != self.server.address:
+                    return self.json({'error': '無法核對本機視窗來源。'}, HTTPStatus.FORBIDDEN)
+                if self.headers.get_content_type() != 'application/json':
+                    raise ValueError('操作只接受 JSON。')
+                size = int(self.headers.get('Content-Length', 0))
+                limit = MAX_DRAFT_BODY if route == 'draft' else MAX_BODY
+                if not 1 <= size <= limit:
+                    raise ValueError('本機請求大小不符。')
+                self.connection.settimeout(5)
+                body = json.loads(self.rfile.read(size))
+                if not isinstance(body, dict):
+                    raise ValueError('本機請求必須是 JSON 物件。')
+                return self.json(state.dispatch(route, body))
+            if route == 'view':
+                arguments = parse_qs(url.query, keep_blank_values=True)
+                return self.json(state.view(arguments.get('sid', [None])[0], before=arguments.get('before', [None])[0]))
+            if route == 'draft':
+                return self.json(state.draft(parse_qs(url.query).get('sid', [None])[0]))
+            if route == 'correction':
+                args = parse_qs(url.query)
+                message_id = args.get('message_id', [''])[0]
+                if len(message_id) > 19 or not message_id.isascii() or not message_id.isdecimal():
+                    raise ValueError('回答編號無效。')
+                return self.json(state.correction(args.get('sid', [None])[0], int(message_id)))
+            if route == 'status':
+                with state.guard:
+                    return self.json({**state.job, 'mode': state.mode, 'selection': state.model_state()})
+            if route == 'trash':
+                return self.json({'sessions': chat_history.trash(state.store)})
+            if route == 'learning':
+                return self.json(state.learning())
+            return self.json({'error': '找不到本機頁面。'}, HTTPStatus.NOT_FOUND)
+        except (chat_drafts.DraftConflict, CorrectionConflict) as exc:
+            return self.json({'error': str(exc)}, HTTPStatus.CONFLICT)
+        except (ValueError, OSError, RuntimeError, KeyError, TypeError, sqlite3.Error) as exc:
+            return self.json({'error': str(exc)[:4000]}, HTTPStatus.BAD_REQUEST)
+
+
+@contextmanager
+def server_for(app):
+    with ThreadingHTTPServer(('127.0.0.1', 0), Handler) as server:
+        server.app = app
+        server.key = secrets.token_urlsafe(24)
+        server.authority = '127.0.0.1:' + str(server.server_port)
+        server.address = 'http://' + server.authority
+        thread = Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        try:
+            yield server.address, server.key
+        finally:
+            server.shutdown()
+            thread.join()
+            app.close()
+
+
+def edge_executable():
+    if os.name == 'nt':
+        import winreg
+        key = r'Software\Microsoft\Windows\CurrentVersion\App Paths\msedge.exe'
+        for hive in (winreg.HKEY_CURRENT_USER, winreg.HKEY_LOCAL_MACHINE):
+            for bits in (winreg.KEY_WOW64_32KEY, winreg.KEY_WOW64_64KEY):
+                try:
+                    with winreg.OpenKey(hive, key, access=winreg.KEY_READ | bits) as handle:
+                        path = Path(winreg.QueryValueEx(handle, '')[0].strip('"'))
+                    if path.is_file():
+                        return path
+                except OSError:
+                    continue
+    system = os.environ.get('SystemDrive', 'C:') + '/'
+    homes = (os.environ.get('ProgramFiles(x86)', system + 'Program Files (x86)'),
+             os.environ.get('ProgramFiles', system + 'Program Files'), os.environ.get('LOCALAPPDATA'))
+    for directory in homes:
+        path = Path(directory or '.') / 'Microsoft/Edge/Application/msedge.exe'
+        if directory and path.is_file():
+            return path
+    raise OSError('找不到 Microsoft Edge，本機 HTML 視窗無法開啟。')
+
+
+def run_window(store):
+    app = ChatApp(store)
+    workspace = store.path.parent / 'local-engine-workspace'
+    workspace.mkdir(parents=True, exist_ok=True)
+    edge = edge_executable()
+    with server_for(app) as (address, key):
+        # The Edge profile is unique to this session. Its job owns browser children.
+        with TemporaryDirectory(prefix='html-profile-', dir=workspace, ignore_cleanup_errors=True) as profile:
+            command = [str(edge), '--app=' + address + '/#key=' + key, '--user-data-dir=' + profile,
+                       '--no-first-run', '--no-default-browser-check', '--disable-background-mode',
+                       '--disable-extensions']
+            with windows_process(command, hidden=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) as process:
+                while process.poll() is None:
+                    time.sleep(0.2)
+
+
+def main():
+    parser = argparse.ArgumentParser(description='啟動本機 HTML 聊天視窗')
+    parser.add_argument('--data-dir', type=Path, default=ROOT / 'data')
+    args = parser.parse_args()
+    try:
+        run_window(Store(args.data_dir / 'assistant.sqlite3'))
+    except (ValueError, OSError, RuntimeError, sqlite3.Error) as exc:
+        parser.exit(1, '本機助理無法開啟視窗。' + str(exc) + '\n')
+
+
+if __name__ == '__main__':
+    main()
