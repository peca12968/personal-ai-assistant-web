index 0000000000000000000000000000000000000000..072d5a21e259c5ab65a5dc4f21ffc0f1f73abf01
--- /dev/null
+++ b/assistant/qwen27_engine.py
@@ -0,0 +1,231 @@
+"""Loopback-only CUDA llama.cpp inference for the verified Qwen3.8-27B GGUF."""
+from contextlib import contextmanager, ExitStack
+import json
+import os
+from pathlib import Path
+from queue import Empty, Queue
+import secrets
+import socket
+import subprocess
+from tempfile import TemporaryFile
+from threading import Thread
+import time
+from urllib.error import HTTPError, URLError
+from urllib.request import ProxyHandler, Request, build_opener
+
+from .engine import EngineError, MAX_ANSWER_BYTES, MAX_PROMPT_BYTES, ROOT
+from . import local_chat_budget
+from .local_worker import SYSTEM_GUIDANCE
+from .owned_process import windows_process
+from scripts.learning.runtime import gpu_lease, require_web_model
+
+
+ASSETS = ROOT / 'data/learning/experiments/qwen38-bf16-rtx5080'
+MODEL_NAME = 'Qwen3.8-27B-BF16.gguf'
+MODEL_SIZE = 53808282240
+MODEL_SHA256 = 'ee11e8694e5c5cffa0ae21895706c97360350e40532979308b756d20a9a717bd'
+MODEL_REVISION = 'c1869413dece09109e55b7dcc2c77ef382b0d0bd'
+BUILD = 'b12758'
+CONTEXT = 8192
+REPLY_TOKENS = 512
+ALIAS = 'qwen38-27b-bf16'
+THINKING = {'reasoning_effort': 'none', 'chat_template_kwargs': {'enable_thinking': False}}
+
+
+def identity(path):
+    stat = path.stat()
+    return stat.st_size, stat.st_mtime_ns
+
+
+def model_assets():
+    model = ASSETS / 'chat' / MODEL_NAME
+    options = list((ASSETS / 'llama-cuda').rglob('llama-server.exe'))
+    if (len(options) != 1 or not (ASSETS / 'runtime-verified.json').is_file()
+            or not (ASSETS / 'chat-verified.json').is_file() or identity(model)[0] != MODEL_SIZE):
+        raise ValueError('F 槽的 27B BF16 權重或 CUDA 執行檔尚未就緒。')
+    return options[0], model
+
+
+def check_running(cancel, deadline):
+    if cancel is not None and cancel.is_set():
+        raise EngineError('已停止本機回答。', 'cancelled')
+    if time.monotonic() >= deadline:
+        raise EngineError('27B 本機回答逾時。', 'timeout')
+
+
+def chat_prompt(prompt):
+    from .engine import render_prompt_parts
+    from .parameter_acceptance import compact_input
+    from .response_delivery import GUIDANCE, PROMPT_MARKER
+
+    compact = compact_input(prompt)
+    if compact != prompt:
+        return compact
+    _, boundary, payload = prompt.rpartition(local_chat_budget.DATA_BOUNDARY)
+    if not boundary or '<|' in payload:
+        return prompt
+    try:
+        context = json.loads(payload)
+        instructions, data = render_prompt_parts(context)
+        if instructions + data != prompt:
+            return prompt
+    except (KeyError, TypeError, ValueError, AttributeError, RecursionError):
+        return prompt
+    static = (ROOT / 'prompts/system.txt').read_text(encoding='utf-8').replace(PROMPT_MARKER, GUIDANCE)
+    if not instructions.startswith(static):
+        return prompt
+    document_rules = local_chat_budget.DOCUMENT_GUIDANCE if context.get('documents', {}).get('catalog') else ''
+    return (local_chat_budget.GUIDANCE + document_rules + '\n' + GUIDANCE
+            + instructions[len(static):] + data)
+
+
+class LlamaSession:
+    def __init__(self, address, key, process, cancel, deadline):
+        self.address, self.key, self.process = address, key, process
+        self.cancel, self.deadline = cancel, deadline
+
+    def request(self, path, body=None, *, timeout=900):
+        data = json.dumps(body, ensure_ascii=False).encode('utf-8') if body is not None else None
+        call = Request(self.address + path, data=data,
+                       headers={'Authorization': 'Bearer ' + self.key, 'Content-Type': 'application/json'})
+        with build_opener(ProxyHandler({})).open(call, timeout=timeout) as stream:
+            data = stream.read(2 * 1024 * 1024 + 1)
+        if len(data) > 2 * 1024 * 1024:
+            raise ValueError('CUDA 伺服器回覆超出大小上限。')
+        return json.loads(data)
+
+    def query(self, path, body):
+        result = Queue(maxsize=1)
+
+        def request():
+            try:
+                result.put((True, self.request(path, body)))
+            except (OSError, ValueError) as exc:
+                result.put((False, exc))
+
+        Thread(target=request, daemon=True).start()
+        while True:
+            check_running(self.cancel, self.deadline)
+            if self.process.poll() is not None:
+                raise EngineError('27B CUDA 伺服器在回答中結束。', 'local_process_failed')
+            try:
+                success, value = result.get(timeout=0.12)
+            except Empty:
+                continue
+            if not success:
+                raise EngineError('27B 本機推理未完成。', 'local_inference_failed') from value
+            return value
+
+    def answer(self, messages, *, max_tokens=REPLY_TOKENS):
+        body = {'model': ALIAS, 'messages': messages, **THINKING}
+        formatted = self.query('/apply-template', body)['prompt']
+        tokens = self.query('/tokenize', {'content': formatted, 'parse_special': True, 'add_special': True})['tokens']
+        if not 1 <= len(tokens) <= CONTEXT - max_tokens - 4:
+            raise EngineError(f'27B 的 {CONTEXT} token 上下文容納不了完整輸入與回答，請縮短本輪內容。', 'local_input_too_large')
+        output = self.query('/v1/chat/completions', {**body, 'max_tokens': max_tokens,
+                            'temperature': 0, 'seed': 42, 'cache_prompt': False})
+        choice, = output['choices']
+        if choice['finish_reason'] == 'length':
+            raise EngineError(f'回答達到 {max_tokens} token 上限，請指定較短的輸出。', 'local_generation_limit')
+        answer = choice['message']['content']
+        usage = output['usage']
+        if (choice['finish_reason'] != 'stop' or not isinstance(answer, str) or not answer.strip()
+                or len(answer.encode('utf-8')) > MAX_ANSWER_BYTES or usage['prompt_tokens'] >= CONTEXT - max_tokens):
+            raise EngineError('27B 回覆內容或長度無法核對。', 'invalid_response')
+        return answer.strip()
+
+
+class Qwen27Engine:
+    def __init__(self, data_dir, *, batch=None, timeout=650):
+        self.data_dir = Path(data_dir).resolve()
+        self.workdir = self.data_dir / 'local-engine-workspace'
+        self.timeout = timeout
+        try:
+            self.executable, self.model = model_assets()
+            self.identities = {item: identity(item) for item in (self.executable, self.model)}
+        except (ValueError, OSError) as exc:
+            raise EngineError('F 槽的 27B BF16 權重或 CUDA 執行檔尚未就緒。', 'local_environment') from exc
+        self.batch = batch
+        self.adapter = None if batch is None else self._candidate()
+        label = ' · LoRA' if batch else ''
+        self.display_name = 'Qwen3.8-27B BF16' + label
+
+    def _candidate(self):
+        from .qwen27_learning import verified_candidate
+        return verified_candidate(self.data_dir, self.batch)
+
+    def describe(self):
+        return {'runs_on_this_computer': True, 'engine': 'llama.cpp CUDA', 'llama_build': BUILD,
+                'model': 'Qwen3.8-27B', 'precision': 'BF16', 'revision': MODEL_REVISION,
+                'context_tokens': CONTEXT, 'confirmed_batch': self.batch is not None,
+                'adapter_batch': self.batch, 'adapter_sha256': self.adapter[1] if self.adapter else None}
+
+    def verify(self):
+        if any(identity(path) != earlier for path, earlier in self.identities.items()):
+            raise EngineError('F 槽權重或 CUDA 執行檔已變更，請重新啟動助理核對。', 'local_model_changed')
+        if self.batch is not None and self._candidate() != self.adapter:
+            raise EngineError('27B 候選版本或確認更正已變更。', 'local_model_changed')
+
+    @contextmanager
+    def session(self, cancel=None, *, test_adapter=None):
+        require_web_model('chat', 'training')
+        deadline = time.monotonic() + self.timeout
+        check_running(cancel, deadline)
+        self.verify()
+        with ExitStack() as stack:
+            try:
+                stack.enter_context(gpu_lease())
+            except RuntimeError:
+                raise EngineError('GPU 正在聊天或微調。請等目前工作結束再送出。', 'local_gpu_busy') from None
+            self.workdir.mkdir(parents=True, exist_ok=True)
+            cache = ASSETS / 'cuda-cache'
+            cache.mkdir(exist_ok=True)
+            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as listener:
+                listener.bind(('127.0.0.1', 0))
+                port = listener.getsockname()[1]
+            key = secrets.token_urlsafe(24)
+            command = [str(self.executable), '--model', str(self.model), '--alias', ALIAS, '--host', '127.0.0.1',
+                '--port', str(port), '--api-key', key, '--device', 'CUDA0', '--ctx-size', str(CONTEXT),
+                '--parallel', '1', '--threads', '8', '--batch-size', '256', '--ubatch-size', '128',
+                '--n-gpu-layers', 'auto', '--fit-target', '1536', '--jinja', '--no-ui', '--no-context-shift']
+            adapter = test_adapter or (self.adapter[0] if self.adapter else None)
+            if adapter:
+                command += ['--lora', str(adapter)]
+            log = stack.enter_context(TemporaryFile(dir=self.workdir))
+            try:
+                process = stack.enter_context(windows_process(command, cwd=self.executable.parent,
+                    env={**os.environ, 'CUDA_CACHE_PATH': str(cache)}, stdin=subprocess.DEVNULL, stdout=log, stderr=log))
+                server = LlamaSession(f'http://127.0.0.1:{port}', key, process, cancel, deadline)
+                while True:
+                    check_running(cancel, deadline)
+                    if process.poll() is not None:
+                        # Runtime startup diagnostics do not include any submitted messages.
+                        log.seek(max(0, log.seek(0, os.SEEK_END) - 3000))
+                        detail = log.read(3000).decode('utf-8', 'replace')
+                        raise EngineError('27B CUDA 伺服器載入失敗。\n' + detail, 'local_start_failed')
+                    try:
+                        if server.request('/health', timeout=1).get('status') == 'ok':
+                            break
+                    except (HTTPError, URLError, TimeoutError):
+                        pass
+                    time.sleep(0.15)
+                yield server
+                check_running(cancel, deadline)
+                self.verify()
+            except (OSError, subprocess.TimeoutExpired) as exc:
+                raise EngineError('27B 本機程序啟動或結束核對失敗。', 'local_io') from exc
+
+    def messages(self, prompt, *, description=None):
+        if not isinstance(prompt, str) or not prompt.strip() or len(prompt.encode('utf-8')) > MAX_PROMPT_BYTES:
+            raise EngineError('本機提示必須為有效文字，並符合大小上限。', 'invalid_input')
+        prompt = chat_prompt(prompt)
+        system = SYSTEM_GUIDANCE + '\n本次本機引擎資訊\n' + json.dumps(description or self.describe(), ensure_ascii=False)
+        return [{'role': 'system', 'content': system}, {'role': 'user', 'content': prompt}]
+
+    def answer(self, prompt, cancel=None):
+        messages = self.messages(prompt)
+        with self.session(cancel) as server:
+            try:
+                return server.answer(messages)
+            except (KeyError, ValueError, TypeError) as exc:
+                raise EngineError('27B 本機回覆格式無法核對。', 'invalid_response') from exc
diff --git a/assistant/qwen27_learning.py b/assistant/qwen27_learning.py
new file mode 100644
index 0000000000000000000000000000000000000000..8b6f2821c6c4336a1aa6c516a182e8420a0171f1
--- /dev/null
+++ b/assistant/qwen27_learning.py
@@ -0,0 +1,318 @@
+"""Prepare and run one idle-only 27B LoRA batch using current local confirmations."""
+from contextlib import ExitStack
+import hashlib
+import os
+from pathlib import Path
+import sqlite3
+import subprocess
+import time
+import unicodedata
+import uuid
+
+from . import idle_learning, learning_batches as batches, learning_queue as queue
+from .engine import EngineError, ROOT
+from .local_models import read_json
+from .owned_process import windows_process
+from .qwen27_engine import ASSETS, MODEL_SHA256, Qwen27Engine, identity, model_assets
+from .store import Store
+from scripts.learning.runtime import fit_launch_ticket, gpu_lease, require_web_model
+
+
+TRAIN_REVISION = '37561816e66b5b9153b1b64c10968c18c1e6f4a0'
+CONVERTER_SHA256 = '9d278b02b1a7a848372f893015c078d150b5c0590859310c1a133440e772ff95'
+CONTROLS = (
+    {'prompt': '只回答一個繁體中文字。英文 cat 的中文是什麼？', 'answer': '貓'},
+    {'prompt': '請只回答數字。17 加 26 等於多少？', 'answer': '43'},
+)
+IDLE_SECONDS = 600
+WAIT_SECONDS = 3600
+WORK_SECONDS = 1800
+
+
+def file_hash(path):
+    with path.open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def training_assets():
+    python = ASSETS / 'train-env/Scripts/python.exe'
+    converter = ASSETS / 'converter/llama.cpp-b12758/convert_lora_to_gguf.py'
+    receipt = read_json(ASSETS / 'train-verified.json')
+    manifest = read_json(ASSETS / 'train-sources.json')
+    if (not python.is_file() or file_hash(converter) != CONVERTER_SHA256 or manifest['revision'] != TRAIN_REVISION
+            or set(receipt['files']) != {row['rfilename'] for row in manifest['files']}):
+        raise ValueError('27B 訓練環境或原始 BF16 權重尚未核對。')
+    files = {}
+    for row in manifest['files']:
+        name = row['rfilename']
+        path = ASSETS / 'train' / name
+        observed = identity(path)
+        if Path(name).name != name or observed[0] != row['size']:
+            raise ValueError('27B BF16 權重分片與驗證清單不符。')
+        files[name] = list(observed)
+    return python, converter, files
+
+
+def job_path(data_dir, job_id):
+    return Path(data_dir).resolve() / 'learning-batches' / '_qwen27_jobs' / batches.identifier(job_id)
+
+
+def normalize_prompt(value):
+    return ''.join(unicodedata.normalize('NFKC', value).split())
+
+
+def read_job(path):
+    manifest = read_json(path / 'manifest.json', 1024 * 1024)
+    receipt = read_json(path / 'receipt.json', 1024 * 1024)
+    if (manifest.get('id') != path.name or manifest.get('schema') != 'qwen27_idle_lora_v1'
+            or manifest.get('base_sha256') != MODEL_SHA256
+            or receipt.get('manifest_sha256') != queue.digest(manifest)):
+        raise ValueError('27B 學習批次與保存規約不符。')
+    return manifest, receipt
+
+
+def prepare(store, selection, holdout):
+    if not isinstance(selection, list) or not 1 <= len(selection) <= 8:
+        raise ValueError('每批請選取 1 至 8 個確認例子。')
+    if not isinstance(holdout, dict) or set(holdout) != {'prompt', 'answer'}:
+        raise ValueError('請提供一題獨立驗收問答。')
+    queue.text(holdout['prompt'], 2000, '驗收問題')
+    queue.text(holdout['answer'], 2000, '驗收答案')
+    seen = {normalize_prompt(row['prompt']) for row in (*CONTROLS, holdout)}
+    if len(seen) != len(CONTROLS) + 1:
+        raise ValueError('驗收問題需與控制題不同。')
+    rows = []
+    ids = set()
+    with store.connect() as db:
+        db.execute('BEGIN')
+        for choice in selection:
+            if not isinstance(choice, dict) or set(choice) != {'id', 'revision'} or type(choice['revision']) is not int:
+                raise ValueError('確認例子選擇格式錯誤。')
+            row = queue.latest(db, choice['id'])
+            key = normalize_prompt(row['prompt'])
+            if (row['id'] in ids or row['revision'] != choice['revision'] or row['status'] != 'confirmed'
+                    or key in seen or not queue.source_current(store, db, row['source'])):
+                raise ValueError('只能使用仍有效的已確認例子，且訓練題與驗收題需不同。')
+            rows.append(row)
+            ids.add(row['id'])
+            seen.add(key)
+    model_assets()
+    _, _, weights = training_assets()
+    job_id = uuid.uuid4().hex
+    path = job_path(store.path.parent, job_id)
+    path.mkdir(parents=True)
+    manifest = {'schema': 'qwen27_idle_lora_v1', 'id': job_id, 'base_sha256': MODEL_SHA256,
+                'train_revision': TRAIN_REVISION, 'weights': weights, 'items': rows,
+                'suite': [holdout, *CONTROLS], 'created': time.time()}
+    batches.save(path / 'manifest.json', manifest)
+    receipt = {'status': 'prepared', 'manifest_sha256': queue.digest(manifest)}
+    batches.save(path / 'receipt.json', receipt)
+    return job_id
+
+
+class IdleGate:
+    def __init__(self, store, manifest, cancel, sensor, idle_seconds, wait_seconds, work_seconds):
+        self.store, self.manifest, self.cancel, self.sensor = store, manifest, cancel, sensor
+        self.idle_seconds, self.work_seconds = idle_seconds, work_seconds
+        self.deadline = time.monotonic() + wait_seconds
+        self.admitted = None
+        self.next_poll = 0
+        self.reason = None
+
+    def check(self):
+        if self.cancel is not None and self.cancel.is_set():
+            raise batches.Stopped('已停止本機學習。')
+        if time.monotonic() >= self.deadline:
+            raise batches.Stopped('已達閒置等待或本機工作的時間上限。')
+        batches.examples_current(self.store, self.manifest)
+        sample = idle_learning.validate_sample(self.sensor())
+        if self.admitted and (sample['last_input_tick'] != self.admitted['last_input_tick']
+                or sample['idle_ms'] < self.idle_seconds * 1000 or sample['ticks_ms'] < self.admitted['ticks_ms']):
+            raise batches.Stopped('偵測到鍵盤或滑鼠恢復使用，已停止學習。')
+        return sample
+
+    def is_set(self):
+        if time.monotonic() >= self.next_poll or (self.cancel and self.cancel.is_set()):
+            self.next_poll = time.monotonic() + 0.5
+            try:
+                self.check()
+            except (ValueError, OSError, RuntimeError, sqlite3.Error) as exc:
+                self.reason = exc
+        return self.reason is not None
+
+    def wait(self):
+        while True:
+            sample = self.check()
+            if sample['idle_ms'] >= self.idle_seconds * 1000:
+                try:
+                    with gpu_lease():
+                        self.admitted = sample
+                except RuntimeError:
+                    pass
+            if self.admitted is not None:
+                self.deadline = time.monotonic() + self.work_seconds
+                self.check()
+                return
+            time.sleep(0.5)
+
+
+def process_job(path, phase, command, gate, *, gpu=False):
+    gate.check()
+    with ExitStack() as stack:
+        if gpu:
+            stack.enter_context(gpu_lease())
+            proof = stack.enter_context(fit_launch_ticket(path))
+        log = stack.enter_context((path / (phase + '.log')).open('wb'))
+        environment = {**os.environ, 'HF_HUB_OFFLINE': '1', 'TRANSFORMERS_OFFLINE': '1',
+                       'HF_HUB_DISABLE_PROGRESS_BARS': '1', 'PYTHONUTF8': '1'}
+        process = stack.enter_context(windows_process([str(part) for part in command], cwd=ROOT, env=environment,
+                         stdin=subprocess.PIPE if gpu else subprocess.DEVNULL, stdout=log, stderr=log))
+        if gpu:
+            with process.stdin as pipe:
+                pipe.write((proof + '\n').encode('ascii'))
+        while process.poll() is None:
+            if gate.is_set():
+                raise gate.reason
+            time.sleep(0.12)
+        if process.returncode:
+            raise ValueError(f'{phase} 程序結束碼 {process.returncode}。詳細紀錄存於本機 {phase}.log。')
+    gate.check()
+
+
+def score(store, path, suite, gate, *, adapter=None):
+    from scripts.daily_delivery import DailyLocalEngine
+    from scripts.daily_expenses import DailyAssistant
+
+    phase = 'candidate' if adapter else 'baseline'
+    isolated = Store(path / phase / 'assistant.sqlite3')
+    raw = Qwen27Engine(store.path.parent, timeout=650)
+    answers = []
+    try:
+        with raw.session(gate, test_adapter=adapter) as server:
+            class CheckedEngine:
+                display_name = raw.display_name
+
+                def describe(self):
+                    values = raw.describe()
+                    if adapter:
+                        values.update(confirmed_batch=True, adapter_batch=path.name, adapter_sha256=file_hash(adapter))
+                    return values
+
+                def answer(self, prompt, cancel=None):
+                    messages = raw.messages(prompt, description=self.describe())
+                    return server.answer(messages, max_tokens=192)
+
+            driver = DailyAssistant(isolated, DailyLocalEngine(CheckedEngine()))
+            for case in suite:
+                reply = driver.ask(isolated.new_session(), case['prompt'], gate)
+                answers.append(reply['content'].strip())
+    except EngineError:
+        if gate.reason:
+            raise gate.reason
+        raise
+    gate.check()
+    return answers
+
+
+def assessment(suite, baseline, updated):
+    if len(suite) != len(baseline) or len(suite) != len(updated) or len(suite) != 3:
+        raise ValueError('27B 驗收結果數量不符。')
+    expected = [case['answer'].strip() for case in suite]
+    return {'baseline': [value == answer for value, answer in zip(baseline, expected, strict=True)],
+            'candidate': [value == answer for value, answer in zip(updated, expected, strict=True)]}
+
+
+def passes(result):
+    return result['baseline'] == [False, True, True] and result['candidate'] == [True, True, True]
+
+
+def run(store, job_id, cancel=None, *, on_progress=None, sensor=idle_learning.idle_sample,
+        idle_seconds=IDLE_SECONDS, wait_seconds=WAIT_SECONDS, work_seconds=WORK_SECONDS):
+    require_web_model('training')
+    path = job_path(store.path.parent, job_id)
+    with batches.owner(path):
+        manifest, receipt = read_job(path)
+        if receipt['status'] != 'prepared':
+            raise ValueError('這個閒置批次已開始過，請建立新批次。')
+        gate = IdleGate(store, manifest, cancel, sensor, idle_seconds, wait_seconds, work_seconds)
+
+        def stage(status):
+            receipt['status'] = status
+            batches.save(path / 'receipt.json', receipt)
+            if on_progress:
+                on_progress(status)
+
+        receipt.update(started=time.time(), automatic_activation=False)
+        try:
+            stage('waiting')
+            gate.wait()
+            python, converter, weights = training_assets()
+            if weights != manifest['weights']:
+                raise batches.Stale('訓練權重自準備後已有變更。')
+            stage('baseline')
+            suite = manifest['suite']
+            baseline = score(store, path, suite, gate)
+            receipt['baseline'] = baseline
+            if baseline[0] == suite[0]['answer'].strip():
+                stage('already_correct')
+            else:
+                stage('training')
+                process_job(path, 'fit', [python, '-I', ROOT / 'scripts/learning/qwen27_worker.py', path], gate, gpu=True)
+                fit = read_json(path / 'fit.json')
+                if fit['initial'] == fit['weights'] or len(fit['steps']) < 2:
+                    raise ValueError('LoRA 權重更新無法核對。')
+                stage('converting')
+                adapter = path / 'adapter.gguf'
+                process_job(path, 'convert', [python, '-E', '-s', converter, '--base', ASSETS / 'train', '--outfile',
+                           adapter, '--outtype', 'f32', path / 'adapter'], gate)
+                if not adapter.is_file():
+                    raise ValueError('未產出可重載的 GGUF 適配器。')
+                receipt['adapter_sha256'] = file_hash(adapter)
+                receipt['trained_weights_sha256'] = fit['weights']
+                stage('checking')
+                updated = score(store, path, suite, gate, adapter=adapter)
+                if file_hash(adapter) != receipt['adapter_sha256']:
+                    raise batches.Stale('GGUF 適配器於驗收期間變更。')
+                result = assessment(suite, baseline, updated)
+                receipt.update(candidate=updated, assessment=result)
+                gate.check()
+                stage('validated' if passes(result) else 'rejected')
+        except batches.Stale as exc:
+            receipt['error'] = str(exc)
+            stage('stale')
+        except batches.Stopped as exc:
+            receipt['error'] = str(exc)
+            stage('cancelled')
+        except (OSError, ValueError, RuntimeError, KeyError, TypeError, sqlite3.Error) as exc:
+            receipt['error'] = str(exc)
+            stage('cancelled' if cancel and cancel.is_set() else 'failed')
+        finally:
+            receipt['ended'] = time.time()
+            batches.save(path / 'receipt.json', receipt)
+        return receipt
+
+
+def verified_candidate(data_dir, job_id):
+    path = job_path(data_dir, job_id)
+    manifest, receipt = read_job(path)
+    adapter = path / 'adapter.gguf'
+    if (receipt['status'] != 'validated' or not passes(assessment(manifest['suite'], receipt['baseline'], receipt['candidate']))
+            or file_hash(adapter) != receipt['adapter_sha256']):
+        raise ValueError('只可選用已通過完整驗收的 27B 適配器。')
+    batches.examples_current(Store(Path(data_dir) / 'assistant.sqlite3'), manifest)
+    return adapter, receipt['adapter_sha256']
+
+
+def recent_jobs(data_dir):
+    parent = Path(data_dir) / 'learning-batches' / '_qwen27_jobs'
+    if not parent.is_dir():
+        return []
+    rows = []
+    for path in sorted(parent.iterdir(), key=lambda candidate: candidate.stat().st_mtime, reverse=True)[:12]:
+        try:
+            _, receipt = read_job(path)
+            ui_row = {key: receipt.get(key) for key in ('status', 'assessment', 'error')}
+            rows.append({'id': path.name, **ui_row})
+        except (ValueError, OSError, KeyError, TypeError):
+            continue
+    return rows
