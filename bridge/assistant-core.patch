+         '/chat.css': ('chat.css', 'text/css')}
+MAX_BODY = 128 * 1024
+MAX_DRAFT_BODY = 6 * chat_drafts.MAX_CHARS + 256
+HISTORY_PAGE_SIZE = 100
+NON_MODEL_REPLIES = {'local_memory', 'local_calculation', 'local_document_calculation', 'local_transcription',
+                     'local_evidence', PROFILE_TONE_MODE}
+MODEL_4B = 'qwen3-4b-bf16'
+MODEL_OPTIONS = {
+    ALIAS: {'label': 'Qwen3.8-27B BF16', 'context_tokens': CONTEXT,
+            'input_tokens': CONTEXT - REPLY_TOKENS - 4, 'output_tokens': REPLY_TOKENS},
+    Q8_ALIAS: {'label': 'Qwen3.8-27B Q8_0', 'context_tokens': Q8_CONTEXT,
+               'input_tokens': Q8_CONTEXT - REPLY_TOKENS - 4, 'output_tokens': REPLY_TOKENS},
+    MODEL_4B: {'label': 'Qwen3-4B BF16', 'context_tokens': None,
+               'input_tokens': local_models.MAX_INPUT_TOKENS, 'output_tokens': local_models.MAX_OUTPUT_TOKENS},
+}
+
+
+class CorrectionConflict(ValueError):
+    pass
+
+
+def saved_answer_context(payload):
+    try:
+        context = json.loads(payload) if payload else {}
+    except (ValueError, RecursionError):
+        return {}
+    return context if isinstance(context, dict) else {}
+
+
+def is_local_reply(context):
+    mode = context.get('response_mode')
+    return context.get(answer_runs.ORIGIN_FIELD) == 'local_tool' or (isinstance(mode, str) and mode in NON_MODEL_REPLIES)
+
+
+def correction_question(context):
+    if not context.get('image_inputs') and not is_local_reply(context):
+        question = context.get('current_request')
+        if isinstance(question, str) and question.strip():
+            return question
+    return None
+
+
+def answer_source(context):
+    if is_local_reply(context):
+        return {'label': '本機工具'}
+    selection = context.get('engine_selection')
+    if not isinstance(selection, dict) or selection.get('runs_on_this_computer') is not True:
+        return {'label': '來源未記錄'}
+    model = selection.get('model')
+    tuning = None
+    details = []
+    if model == 'Qwen3.8-27B' and selection.get('precision') == 'BF16':
+        name = MODEL_OPTIONS[ALIAS]['label']
+        if selection.get('confirmed_batch') is True:
+            batch = selection.get('adapter_batch')
+            tuning = 'LoRA 版本未記錄'
+            if isinstance(batch, str) and re.fullmatch(r'[0-9a-f]{32}', batch):
+                tuning = 'LoRA ' + batch[:8]
+                details.append('LoRA 批次 ' + batch)
+        elif selection.get('confirmed_batch') is False:
+            tuning = '底座'
+    elif model == 'Qwen3.8-27B' and selection.get('precision') == 'Q8_0':
+        name = MODEL_OPTIONS[Q8_ALIAS]['label']
+    elif model == 'Qwen/Qwen3-4B' and selection.get('kind') == 'local_qwen':
+        name = MODEL_OPTIONS[MODEL_4B]['label']
+        version = selection.get('parameter_version')
+        if version == 'unadapted_base':
+            tuning = '底座'
+        elif isinstance(version, str) and re.fullmatch('[a-z0-9_-]{1,64}', version):
+            tuning = version
+    else:
+        return {'label': '來源未記錄'}
+    revision = selection.get('revision')
+    if isinstance(revision, str) and re.fullmatch(r'[0-9a-f]{40}', revision):
+        version_label = 'GGUF 版本' if selection.get('precision') == 'Q8_0' else '底座版本'
+        details.append(version_label + ' ' + revision)
+    prefix = '' if context.get(answer_runs.ORIGIN_FIELD) == 'model' else '當時選用 '
+    suffix = ' · ' + tuning if tuning else ''
+    return {'label': prefix + name + suffix, 'detail': '\n'.join(details)}
+
+
+class ChatApp:
+    def __init__(self, store, *, controlled=False):
+        self.store = store
+        self.controlled = controlled
+        self.mode = 'off'
+        self.switching = False
+        self.guard = RLock()
+        self.cancel = Event()
+        self.model_task = None
+        self.worker = None
+        self.job = {}
+        self.draft_job = None
+        self.choice = store.path.parent / 'local-engine-workspace' / 'qwen27-choice.json'
+        self.warning = ''
+        try:
+            choice = read_json(self.choice) if self.choice.is_file() else {}
+            self.set_engine(choice.get('model', ALIAS), choice.get('batch'))
+        except (ValueError, OSError, KeyError, TypeError, AttributeError, RuntimeError, sqlite3.Error):
+            self.set_engine(ALIAS)
+            self.warning = '無法核對已保存的模型，先選用 27B BF16 底座。'
+
+    def set_engine(self, model, batch=None, *, persist=False):
+        if model == ALIAS:
+            engine = Qwen27Engine(self.store.path.parent, batch=batch)
+        elif model == Q8_ALIAS and batch is None:
+            engine = Qwen27Engine(self.store.path.parent, alias=Q8_ALIAS)
+        elif model == MODEL_4B and batch is None:
+            engine = LocalEngine(self.store.path.parent, recover_chat_budget=True, web_owned=True)
+            if not engine.python.is_file():
+                raise EngineError('F 槽的 Qwen3-4B 執行環境尚未就緒。', 'local_environment')
+        else:
+            raise ValueError('請選擇此電腦支援的模型版本。')
+        if persist:
+            self.choice.parent.mkdir(parents=True, exist_ok=True)
+            learning_batches.save(self.choice, {'model': model, 'batch': batch})
+        self.model = model
+        self.batch = batch
+        self.engine = engine
+        self.driver = DailyAssistant(self.store, WebChatEngine(engine))
+
+    def model_state(self):
+        return {'id': self.model, 'batch': self.batch}
+
+    def view(self, sid, *, before=None):
+        if before is not None:
+            if (not isinstance(before, str) or len(before) > 19 or not before.isascii() or not before.isdecimal()
+                    or not 1 <= int(before) < 2**63):
+                raise ValueError('歷史分頁位置無效。')
+            return self.history_page(chat_history.session_id(sid), before=int(before))
+        rows = self.store.sessions()
+        session = next((row for row in rows if row['id'] == sid), None)
+        if session is None:
+            session = rows[0] if rows else None
+        if session is None:
+            sid = self.store.new_session()
+            rows = self.store.sessions()
+            session = rows[0]
+        sid = session['id']
+        answer_runs.recover(self.store, sid)
+        page = self.history_page(sid)
+        models = {**MODEL_OPTIONS, Q8_ALIAS: {**MODEL_OPTIONS[Q8_ALIAS], 'available': q8_assets_ready()}}
+        with self.guard:
+            return {**page, 'title': session['title'], 'model': self.engine.display_name,
+                    'sessions': [{key: row[key] for key in ('id', 'title')} for row in rows],
+                    'can_retry': page['retry'] is not None, 'warning': self.warning, 'mode': self.mode,
+                    'models': models, 'selection': self.model_state()}
+
+    def history_page(self, sid, *, before=None):
+        with self.store.connect() as db:
+            db.execute('BEGIN')
+            chat_history.assert_active(db, sid)
+            if before is not None and not db.execute('SELECT 1 FROM messages WHERE session_id=? AND id=?', (sid, before)).fetchone():
+                raise ValueError('這個分頁位置已失效，請重開該對話。')
+            upper = ' AND id < ?' if before is not None else ''
+            args = (sid, before) if before is not None else (sid,)
+            recent = db.execute(f'''SELECT m.*, c.payload, f.correction FROM (
+                    SELECT id, role, content FROM messages WHERE session_id=?{upper}
+                    ORDER BY id DESC LIMIT ?
+                ) AS m LEFT JOIN answer_contexts c ON c.message_id=m.id
+                LEFT JOIN feedback f ON f.message_id=m.id AND f.rating=-1
+                ORDER BY m.id DESC''', (*args, HISTORY_PAGE_SIZE + 1)).fetchall()
+            messages = []
+            for row in reversed(recent[:HISTORY_PAGE_SIZE]):
+                message = {key: row[key] for key in ('id', 'role', 'content')}
+                if row['role'] == 'assistant':
+                    context = saved_answer_context(row['payload'])
+                    message['source'] = answer_source(context)
+                    if context.get(answer_runs.ORIGIN_FIELD) == 'model':
+                        usage = answer_runs.checked_token_usage(context.get(answer_runs.USAGE_FIELD))
+                        if usage is not None:
+                            message['source']['usage'] = usage
+                    if (timing := answer_runs.checked_timing(context.get(answer_runs.TIMING_FIELD))) is not None:
+                        message['source']['timing'] = timing
+                    if (question := correction_question(context)) is not None:
+                        message.update(correctable=True, question=question[:2000], correction=row['correction'] or '')
+                messages.append(message)
+            latest = {}
+            if before is None:
+                retry = None
+                try:
+                    target = answer_runs.retry_snapshot(db, sid)
+                    retry = {key: target[key] for key in ('id', 'user_message_id', 'status')}
+                    if 'timing' in target:
+                        retry.update(timing=target['timing'],
+                                     source=answer_source({'engine_selection': target['timing_selection']})['label'])
+                except ValueError:
+                    pass
+                latest.update(draft=chat_drafts.read(db, sid), retry=retry)
+        cursor = str(messages[0]['id']) if len(recent) > HISTORY_PAGE_SIZE else None
+        return {'sid': sid, 'messages': messages, 'before': cursor, **latest}
+
+    def draft(self, sid, update=None):
+        sid = chat_history.session_id(sid)
+        with self.store.connect() as db:
+            db.execute('BEGIN' if update is None else 'BEGIN IMMEDIATE')
+            chat_history.assert_active(db, sid)
+            if update is None:
+                return chat_drafts.read(db, sid)
+            return chat_drafts.write(db, sid, update['content'], update['revision'])
+
+    def require_session(self, sid):
+        if not isinstance(sid, str) or not any(row['id'] == sid for row in self.store.sessions()):
+            raise ValueError('請選擇有效的本機對話。')
+
+    def start(self, kind, action, *, job_id=None, sid=None, draft=None):
+        with self.guard:
+            mode = 'training' if kind == 'learning' else 'chat'
+            if not self.controlled or self.mode != mode or self.switching:
+                raise ModelPowerRequired('請先在 IIS 網頁打開對應開關。')
+            if self.job.get('running'):
+                raise ValueError('目前正在處理本機工作。可先按停止，等程序退出再操作。')
+            self.cancel = Event()
+            started = time.time()
+            job = {'id': job_id or uuid.uuid4().hex, 'kind': kind, 'running': True, 'stage': 'queued',
+                   'started_at': started, 'stage_started_at': started}
+            if sid is not None:
+                job['sid'] = sid
+            self.job = job
+            self.draft_job = (job['id'], sid, draft) if draft is not None else None
+
+            def progress(stage):
+                with self.guard:
+                    if job['stage'] != stage:
+                        job.update(stage=stage, stage_started_at=time.time())
+
+            task = self.model_task = WebModelTask(mode, self.cancel, on_progress=progress)
+
+            def run():
+                stage, error = 'failed', '本機背景工作中斷。'
+                try:
+                    with task.activate():
+                        result = action(task.cancel, progress)
+                    stage = result['status'] if kind == 'learning' else ('cancelled' if task.cancel.is_set() else 'done')
+                    error = result.get('error') if kind == 'learning' else None
+                except (ValueError, OSError, RuntimeError, KeyError, TypeError, sqlite3.Error) as exc:
+                    stage = 'cancelled' if task.cancel.is_set() else 'failed'
+                    error = str(exc)[:4000]
+                finally:
+                    committed = None
+                    if draft is not None:
+                        try:
+                            committed = chat_drafts.submitted(self.store, sid, draft)
+                        except (OSError, sqlite3.Error):
+                            pass  # An uncertain receipt must not clear the editor.
+                    with self.guard:
+                        if draft is not None:
+                            job['draft_submitted'] = committed
+                        job.update(last_active_stage=job['stage'], stage=stage, running=False, error=error)
+
+            self.worker = Thread(target=run, daemon=True)
+            try:
+                self.worker.start()
+            except RuntimeError:
+                job.update(stage='failed', running=False, error='無法啟動本機背景工作。')
+                raise
+            return dict(job)
+
+    def status(self):
+        with self.guard:
+            state = {**self.job, 'mode': self.mode, 'selection': self.model_state()}
+            pending = self.draft_job
+            if state.get('running') and state['stage'] == 'chat_loading' and self.model_task is not None:
+                with self.model_task.lock:
+                    if self.model_task.load_percent is not None:
+                        state['load_percent'] = self.model_task.load_percent
+        if pending is not None and state.get('id') == pending[0] and state.get('draft_submitted') is not True:
+            _, sid, draft = pending
+            try:
+                state['draft_submitted'] = chat_drafts.submitted(self.store, sid, draft)
+            except (OSError, sqlite3.Error):
+                pass
+        return state
+
+    def correction(self, sid, message_id):
+        with self.store.connect() as db:
+            db.execute('BEGIN')
+            return self.correction_snapshot(db, sid, message_id)[0]
+
+    def correction_snapshot(self, db, sid, message_id):
+        chat_history.session_id(sid)
+        if type(message_id) is not int or not 1 <= message_id < 2**63:
+            raise ValueError('回答編號無效。')
+        chat_history.assert_active(db, sid)
+        row = db.execute('''SELECT m.content, c.payload, f.rating, f.correction, f.updated_at, v.revision
+                FROM messages m LEFT JOIN answer_contexts c ON c.message_id=m.id
+                LEFT JOIN feedback f ON f.message_id=m.id LEFT JOIN feedback_versions v ON v.message_id=m.id
+                WHERE m.id=? AND m.session_id=? AND m.role='assistant' ''', (message_id, sid)).fetchone()
+        question = correction_question(saved_answer_context(row['payload'])) if row is not None else None
+        if question is None:
+            raise ValueError('請選擇有原問題快照的助理文字回答。')
+        matching = []
+        for raw in db.execute(learning_queue.LATEST + " WHERE q.source_json<>'null'"):
+            entry = learning_queue.decode(raw)
+            if entry['source']['message_id'] == message_id:
+                matching.append(entry)
+        if len(matching) > 1:
+            raise ValueError('這則回覆有多個學習例子，請先從學習佇列核對。')
+        entry = matching[0] if matching else None
+        version = learning_queue.digest({'sid': sid, 'message_id': message_id, 'reply': dict(row),
+                                         'example': entry['fingerprint'] if entry else None})
+        state = learning_queue.observed(self.store, db, entry)['readiness'] if entry else 'new'
+        saved_answer = row['correction'] if row['rating'] == -1 else ''
+        if entry and state != 'needs_review':
+            question, saved_answer = entry['prompt'], entry['answer']
+        return {'version': version, 'state': state, 'prompt': question[:2000], 'answer': saved_answer or ''}, entry
+
+    def confirm(self, body):
+        message_id, sid = body['message_id'], body['sid']
+        prompt = learning_queue.text(body['prompt'], 2000, '可獨立理解的問題')
+        answer = learning_queue.text(body['answer'], 2000, '完整正確答案')
+        with self.store.connect() as db:
+            db.execute('BEGIN IMMEDIATE')
+            snapshot, previous = self.correction_snapshot(db, sid, message_id)
+            if body.get('version') != snapshot['version']:
+                raise CorrectionConflict('更正已改版或撤回。請核對本機版本後再確認，目前輸入已保留。')
+            self.store.rate(message_id, -1, answer, db=db)
+            source = learning_queue.source_from_feedback(self.store, message_id, db=db)
+            options = {'item_id': previous['id'], 'expected_revision': previous['revision']} if previous else {}
+            entry = learning_queue.confirm(self.store, prompt, answer, source=source, db=db, **options)
+            return {'id': entry['id'], 'revision': entry['revision']}
+
+    def learning(self):
+        with self.store.connect() as db:
+            db.execute('BEGIN')
+            rows = db.execute(learning_queue.LATEST + " WHERE q.status='confirmed' ORDER BY q.rowid DESC").fetchall()
+            examples = []
+            for record in rows:
+                item = learning_queue.observed(self.store, db, learning_queue.decode(record))
+                if item['readiness'] == 'ready':
+                    examples.append({key: item[key] for key in ('id', 'prompt', 'revision', 'status')})
+        with self.guard:
+            active = self.batch
+        return {'examples': examples, 'jobs': qwen27_learning.recent_jobs(self.store, active=active),
+                'active': active}
+
+    def change_mode(self, requested):
+        if not self.controlled or requested not in ('off', 'chat', 'training'):
+            raise ValueError('模式請選擇關閉、使用模型或訓練。')
+        with self.guard:
+            if self.switching:
+                raise ValueError('正在等候本機程序結束。')
+            if requested == self.mode:
+                return {'mode': self.mode}
+            self.switching = True
+            self.mode = 'stopping'
+            worker, task = self.worker, self.model_task
+        try:
+            if task:
+                task.force_stop()
+            if worker:
+                worker.join(timeout=25)
+                if worker.is_alive():
+                    raise TimeoutError('尚未能確認模型程序已完全退出。')
+            with self.guard:
+                self.mode = requested
+                return {'mode': self.mode}
+        finally:
+            with self.guard:
+                self.switching = False
+
+    def dispatch(self, route, body):
+        if route == 'mode':
+            return self.change_mode(body['mode'])
+        if route == 'stop':
+            with self.guard:
+                task = self.model_task
+            if task:
+                task.force_stop()
+            return {'stopping': True}
+        if route == 'confirm':
+            return self.confirm(body)
+        if route == 'draft':
+            return self.draft(body['sid'], body)
+        if route == 'withdraw':
+            row = learning_queue.withdraw(self.store, body['id'], body['revision'])
+            return {'status': row['status']}
+        with self.guard:
+            if self.switching or self.mode == 'stopping' or self.job.get('running'):
+                raise ValueError('請等本機工作結束後再操作。')
+            if route in ('trash', 'restore', 'purge'):
+                return chat_history.change(self.store, body['sid'], route)
+            if route == 'new':
+                return {'sid': self.store.new_session()}
+            if route == 'select':
+                if 'model' not in body and 'id' not in body:
+                    raise ValueError('請選擇模型。')
+                if 'model' in body and body.get('id') is not None:
+                    raise ValueError('每次只能選擇一個模型版本。')
+                self.set_engine(body.get('model', ALIAS), body.get('id'), persist=True)
+                self.warning = ''
+                return {'model': self.engine.display_name, 'selection': self.model_state()}
+            if route == 'learn':
+                if not self.controlled or self.mode != 'training':
+                    raise ValueError('請先打開訓練開關。')
+                job_id = qwen27_learning.prepare(self.store, body['selection'], body['holdout'])
+                return self.start('learning', lambda cancel, progress: qwen27_learning.run(
+                    self.store, job_id, cancel, on_progress=progress), job_id=job_id)
+            if route in ('ask', 'retry'):
+                if not self.controlled or self.mode != 'chat':
+                    raise ValueError('請先打開使用模型開關。')
+                if 'expected_model' in body and body['expected_model'] != self.model_state():
+                    raise ValueError('其他分頁已變更模型。請核對頁首後再送出。')
+                sid = body['sid']
+                self.require_session(sid)
+                if self.batch is not None:
+                    qwen27_learning.available_candidate(self.store, self.batch)
+                question = body.get('question')
+                submission = None
+                expected_run = None
+                if route == 'retry':
+                    expected_run = body.get('expected_run_id')
+                    if not isinstance(expected_run, str) or not re.fullmatch(r'[0-9a-f]{32}', expected_run):
+                        raise answer_runs.RetryConflict('請重新載入對話，核對要重試的問題。')
+                    answer_runs.retry_target(self.store, sid, expected_id=expected_run)
+                if route == 'ask':
+                    learning_queue.text(question, MAX_QUESTION_CHARS, '問題')
+                    if 'draft_revision' in body:
+                        snapshot = self.draft(sid)
+                        revision = body['draft_revision']
+                        if type(revision) is not int or revision < 1 or snapshot['revision'] != revision or snapshot['content'].strip() != question.strip():
